# backend/.env — 이 파일을 복사해서 backend/.env로 만들고 필요한 값을 채우세요.
# (.env는 .gitignore에 의해 커밋되지 않습니다. 이 예시 파일만 커밋됩니다.)

# ── DB 연결 (2026-07-14 추가) ───────────────────────────────────
# APP_ENV: local(기본값, 개인 로컬 DB) | development(팀 공통 개발 DB) |
#          test(자동화 테스트 — pytest가 알아서 in-memory로 씀, 보통 직접 안 건드림) |
#          production(운영 DB)
#
# DATABASE_URL을 생략하면 APP_ENV=local일 때만 지금까지처럼 로컬 SQLite(app.db)를 씁니다.
# APP_ENV=development 또는 production인데 DATABASE_URL이 없으면 서버가 즉시 에러를 내며
# 멈춥니다(팀 공통/운영 DB를 실수로 로컬 SQLite로 기동하는 사고 방지).
#
# 팀 공통 개발 DB에 붙으려면: APP_ENV=development로 바꾸고 아래 DATABASE_URL을
# 팀에서 공유한 접속 정보로 채우세요(비밀번호를 이 파일이 아니라 본인 .env에만 넣을 것).
APP_ENV=local
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE

# [2026-07-15 추가] Aiven 등 관리형 MySQL은 SSL 연결이 필수(ssl-mode=REQUIRED)다 —
# pymysql은 URL 쿼리스트링이 아니라 이 플래그로 SSL을 켠다. 팀 공통 개발 DB(Aiven)를
# 쓴다면 true로 설정할 것 — 아니면 연결이 거부된다.
# DATABASE_SSL_REQUIRED=true

# [2026-07-15 추가] CA 인증서 경로 — 있으면 서버 인증서까지 검증(권장), 없으면 암호화만
# 하고 인증서는 검증하지 않는다(MITM에 취약). Aiven 콘솔에서 받은 ca.pem 경로를 넣으세요.
# development는 생략해도 동작하지만, production은 이 값이 없으면 서버가 기동을 거부한다.
# DATABASE_SSL_CA=/path/to/ca.pem

# ── OCR (담당: 권순현) ──────────────────────────────────────────
# clova(기본값) | mock — CLOVA 키 없이 파이프라인만 테스트하려면 mock으로 설정
OCR_PROVIDER=mock
CLOVA_OCR_API_URL=
CLOVA_OCR_SECRET_KEY=

# ── RAG (담당: 김영혜) ──────────────────────────────────────────
# real로 설정하면 rag/의 실제 파이프라인(LangChain+ChromaDB)을 호출합니다.
# 미설정(기본값)이면 흐름 확인용 가짜 데이터가 나갑니다.
# ⚠️ real로 켜려면: (1) backend가 실행되는 venv에 rag/requirements.txt의
#    의존성(langchain 등)이 설치돼 있어야 하고, (2) rag/.env에
#    OPENAI_API_KEY/DATA_GO_KR_SERVICE_KEY가 채워져 있어야 합니다 — backend 자체
#    .env에는 OpenAI 키를 따로 둘 필요 없습니다(한 곳에서만 관리).
#    둘 중 하나라도 없으면 조용히 가짜 데이터로 폴백합니다(에러 안 남).
RAG_PROVIDER=stub

# ── 챗봇 (담당: 김영혜) ─────────────────────────────────────────
# real로 설정하면 /chat/ask가 환자의 최근 OCR·가이드 결과를 참고해 GPT로 답변을
# 생성합니다. 미설정(기본값)이면 고정 답변(PRESET_QUESTIONS)이 나갑니다.
# RAG_PROVIDER와 마찬가지로 rag/.env의 OPENAI_API_KEY를 재사용합니다.
CHAT_PROVIDER=stub

# ── Langfuse Cloud 관측/추적 (선택) ────────────────────────────────
# 설정하면 /chat/ask 호출 흐름을 Langfuse Cloud에서 trace로 확인할 수 있습니다.
# Secret/Public key는 Langfuse Cloud Project Settings > API Keys에서 발급합니다.
# 실제 값은 backend/.env에만 넣고, 이 예시 파일이나 프론트엔드 환경변수에는 넣지 마세요.
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── 로그인 (담당: 박소정, 환자 로그인 확장/개인정보 암호화: 김영혜) ─────
# [7/9] auth_router가 main.py에 등록되어 실제로 쓰입니다. 보호자/환자 둘 다
# 이메일 또는 전화번호 + 비밀번호로 로그인 가능(POST /auth/login).
SECRET_KEY=change-this-secret-key-before-deploy

# [7/9 신규] 개인정보(이름·전화번호) 암호화 — 2026-07-08 멘토링 확정 방침.
# 둘 다 없으면 backend/security.py가 서버 기동 시점에 즉시 에러를 냅니다
# (평문 저장으로 조용히 넘어가는 사고를 막기 위함).
# 생성 방법:
#   PII_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   PII_HASH_SECRET:    python -c "import secrets; print(secrets.token_hex(32))"
PII_ENCRYPTION_KEY=
PII_HASH_SECRET=

# ── 이메일 발송 (담당: 김영혜, REQ-039 비밀번호 재설정) ─────────────
# mock(기본값) | smtp — OCR_PROVIDER/RAG_PROVIDER와 동일한 패턴.
# mock은 실제로 보내지 않고 서버 로그에만 남깁니다(로컬/테스트 기본값, 안전).
# smtp로 켜면 아래 SMTP_* 값으로 실제 메일을 발송합니다 — 넷 중 하나라도
# 비어있으면 (mock과 달리) 조용히 넘어가지 않고 서버가 즉시 에러를 냅니다
# (재설정 코드가 영영 발송 안 되는 상황을 숨기지 않기 위함).
EMAIL_PROVIDER=mock
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
