# backend/.env — 이 파일을 복사해서 backend/.env로 만들고 필요한 값을 채우세요.
# (.env는 .gitignore에 의해 커밋되지 않습니다. 이 예시 파일만 커밋됩니다.)

# ── OCR (담당: 권순현) ──────────────────────────────────────────
# clova(기본값) | mock — CLOVA 키 없이 파이프라인만 테스트하려면 mock으로 설정
OCR_PROVIDER=mock
CLOVA_OCR_API_URL=
CLOVA_OCR_SECRET_KEY=

# ── RAG (담당: 김영혜) ──────────────────────────────────────────
# real로 설정하면 rag-prototype/의 실제 파이프라인(LangChain+ChromaDB)을 호출합니다.
# 미설정(기본값)이면 흐름 확인용 가짜 데이터가 나갑니다.
# ⚠️ real로 켜려면: (1) backend가 실행되는 venv에 rag-prototype/requirements.txt의
#    의존성(langchain 등)이 설치돼 있어야 하고, (2) rag-prototype/.env에
#    OPENAI_API_KEY/DATA_GO_KR_SERVICE_KEY가 채워져 있어야 합니다 — backend 자체
#    .env에는 OpenAI 키를 따로 둘 필요 없습니다(한 곳에서만 관리).
#    둘 중 하나라도 없으면 조용히 가짜 데이터로 폴백합니다(에러 안 남).
RAG_PROVIDER=stub

# ── 챗봇 (담당: 김영혜) ─────────────────────────────────────────
# real로 설정하면 /chat/ask가 환자의 최근 OCR·가이드 결과를 참고해 GPT로 답변을
# 생성합니다. 미설정(기본값)이면 고정 답변(PRESET_QUESTIONS)이 나갑니다.
# RAG_PROVIDER와 마찬가지로 rag-prototype/.env의 OPENAI_API_KEY를 재사용합니다.
CHAT_PROVIDER=stub

# ── 로그인 (담당: 김영혜, [7/6 보류] 이번 스프린트 범위 밖) ──────────
# main.py에서 auth_router 등록이 주석 처리돼 있어 지금은 안 쓰입니다.
SECRET_KEY=change-this-secret-key-before-deploy
