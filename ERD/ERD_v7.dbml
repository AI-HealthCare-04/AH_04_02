// 진료기록 기반 복약·생활습관 안내 시스템 — DBML (ERD_v7.md 기준)
// dbdiagram.io 또는 drawSQL에 그대로 붙여넣어 시각화하세요.
//
// [정규화 점검 메모]
// - 2NF: 모든 테이블이 단일 컬럼 서로게이트 키(id)를 사용하므로 부분 함수 종속(partial dependency) 문제 자체가 발생하지 않음.
//   (education_profiles의 (medication_subject_id, cycle_number) UNIQUE는 후보키가 아니라 무결성 제약이라 2NF 위반 아님)
// - 3NF 후보 이슈 1건: extracted_medications.drug_class는 원칙적으로 drug_name에 함수 종속되는 값(약물 자체의 속성)이라
//   순수 3NF 관점에서는 별도 drugs 마스터 테이블로 분리하고 FK로 참조하는 게 이상적. 다만 이 테이블은 OCR 원본 추출 스냅샷이라
//   같은 약물이라도 스캔마다 오인식될 수 있어(권장값이 아닌 "이 기록에서 읽힌 값") 의도적으로 비정규화한 것으로 보임 — 팀 판단 필요.
// - care_relations.relation_type은 care_relation_invitations.relation_type과 중복 저장처럼 보이지만, invitation_id가
//   nullable(자동 승인/직접 생성 경로 존재)이라 완전한 함수 종속이 아니므로 3NF 위반 아님(의도된 비정규화 아님, 정상 설계).

Enum role_enum {
  medication_subject
  guardian
  caregiver
  life_support_worker
  social_worker
  admin
}

Enum user_status_enum {
  active
  withdrawal_pending
  deleted
}

Enum temp_code_purpose_enum {
  locked_account_password_reset
}

Enum delivery_channel_enum {
  email
  sms
}

Enum purge_status_enum {
  scheduled
  cancelled
  completed
  partial
  failed
}

Enum level_enum {
  normal
  mild
  severe
}

Enum care_level_enum {
  independent
  guardian_check
  third_party_needed
}

Enum notice_type_enum {
  guardian_connection_recommendation
}

Enum relation_type_enum {
  guardian
  caregiver
  life_support_worker
  social_worker
}

Enum invitation_status_enum {
  pending
  accepted
  rejected
  expired
  cancelled
}

Enum care_relation_status_enum {
  approved
  revocation_pending
  revoked
}

Enum revocation_decision_enum {
  approved
  rejected
}

Enum medical_record_status_enum {
  processing
  review_required
  done
  failed
}

Enum chat_role_enum {
  user
  assistant
}

Enum intake_status_enum {
  taken
  missed
  skipped
}

Enum notification_type_enum {
  medication_reminder
  care_alert
  intake_confirmed
}

Enum education_stage_enum {
  freshman
  junior
  senior
}

Enum education_status_enum {
  active
  completed
  paused
}

Enum support_type_enum {
  in_app
  phone
  visit
}

Table users {
  id bigint [pk, increment]
  email varchar [unique, note: 'nullable']
  phone varchar [unique, note: 'nullable']
  password_hash varchar
  name varchar
  role role_enum
  status user_status_enum
  birthday date [note: 'nullable']
  address varchar [note: 'nullable']
  special_notes varchar [note: 'nullable']
  failed_login_count int
  locked_at datetime [note: 'nullable']
  last_failed_login_at datetime [note: 'nullable']
  last_login_at datetime [note: 'nullable']
  withdrawal_requested_at datetime [note: 'nullable']
  deactivated_at datetime [note: 'nullable']
  scheduled_purge_at datetime [note: 'nullable']
  created_at datetime
  updated_at datetime
}

Table auth_refresh_tokens {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  token_hash varchar [unique]
  expires_at datetime
  revoked_at datetime [note: 'nullable']
  replaced_by_token_id bigint [ref: > auth_refresh_tokens.id, note: 'nullable']
  created_at datetime
}

Table auth_temporary_codes {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  code_hash varchar
  purpose temp_code_purpose_enum
  delivery_channel delivery_channel_enum
  delivery_target_masked varchar
  expires_at datetime
  used_at datetime [note: 'nullable']
  verification_attempt_count int
  resend_count int
  created_at datetime
}

Table privacy_purge_audits {
  id bigint [pk, increment]
  subject_reference_hash varchar [unique, note: '비식별 사용자 참조값']
  withdrawal_requested_at datetime
  scheduled_purge_at datetime
  purged_at datetime [note: 'nullable']
  cancelled_at datetime [note: 'nullable']
  purge_status purge_status_enum
  retained_legal_data boolean
  result_details "json" [note: 'nullable; 개인정보 제외']
  created_at datetime
  updated_at datetime
}

Table medication_subject_statuses {
  id bigint [pk, increment]
  medication_subject_id bigint [ref: > users.id]
  updated_by bigint [ref: > users.id]
  cognitive_level level_enum
  mobility_level level_enum
  vision_level level_enum
  medication_awareness boolean
  medication_willingness boolean
  created_at datetime
}

Table care_level_assessments {
  id bigint [pk, increment]
  medication_subject_id bigint [ref: > users.id]
  status_id bigint [ref: - medication_subject_statuses.id, note: '1:1 assessed_from']
  care_level care_level_enum
  reason varchar
  evaluated_at datetime
}

Table care_level_notice_dismissals {
  id bigint [pk, increment]
  medication_subject_id bigint [ref: > users.id]
  dismissed_by bigint [ref: > users.id]
  notice_type notice_type_enum
  dismissed_at datetime
  dismissed_until datetime
}

Table care_relation_invitations {
  id bigint [pk, increment]
  medication_subject_id bigint [ref: > users.id]
  invited_phone varchar
  relation_type relation_type_enum
  invite_token_hash varchar [unique]
  status invitation_status_enum
  expires_at datetime
  matched_user_id bigint [ref: > users.id, note: 'nullable']
  accepted_at datetime [note: 'nullable']
  rejected_at datetime [note: 'nullable']
  created_by bigint [ref: > users.id]
  created_at datetime
  updated_at datetime
}

Table care_relations {
  id bigint [pk, increment]
  invitation_id bigint [ref: - care_relation_invitations.id, note: 'nullable; 1:1 accepted_invitation']
  medication_subject_id bigint [ref: > users.id]
  related_user_id bigint [ref: > users.id, note: 'NOT NULL']
  relation_type relation_type_enum
  status care_relation_status_enum
  approved_by bigint [ref: > users.id]
  approved_at datetime
  revocation_requested_by bigint [ref: > users.id, note: 'nullable']
  revocation_requested_at datetime [note: 'nullable']
  revocation_decided_by bigint [ref: > users.id, note: 'nullable']
  revocation_decided_at datetime [note: 'nullable']
  revocation_decision revocation_decision_enum [note: 'nullable']
  created_at datetime
  updated_at datetime
}

Table medical_records {
  id bigint [pk, increment]
  uploaded_by bigint [ref: > users.id]
  uploaded_for bigint [ref: > users.id, note: 'NOT NULL; self upload이면 uploaded_by와 동일']
  image_url varchar
  status medical_record_status_enum
  ocr_raw_text text
  ocr_provider varchar [note: 'easyocr']
  uploaded_at datetime
  ocr_completed_at datetime [note: 'nullable']
}

Table extracted_medications {
  id bigint [pk, increment]
  medical_record_id bigint [ref: > medical_records.id]
  drug_name varchar
  dosage varchar
  frequency varchar
  diagnosis varchar
  drug_class varchar
  confidence decimal [note: '0.0000~1.0000']
  user_confirmed boolean
  created_at datetime
}

Table guide_results {
  id bigint [pk, increment]
  medical_record_id bigint [ref: > medical_records.id]
  medication_guide "json"
  lifestyle_guide "json"
  source_refs "json"
  cached boolean
  cache_key varchar [note: 'nullable']
  cache_expires_at datetime [note: 'nullable']
  disclaimer varchar
  generated_at datetime
}

Table chat_messages {
  id bigint [pk, increment]
  guide_result_id bigint [ref: > guide_results.id]
  user_id bigint [ref: > users.id]
  role chat_role_enum
  message text
  created_at datetime
}

Table medication_schedules {
  id bigint [pk, increment]
  medication_subject_id bigint [ref: > users.id]
  extracted_medication_id bigint [ref: > extracted_medications.id]
  scheduled_time time
  timezone varchar [note: 'Asia/Seoul']
  notify_guardian boolean
  active boolean
  created_at datetime
}

Table medication_intake_logs {
  id bigint [pk, increment]
  schedule_id bigint [ref: > medication_schedules.id]
  confirmed_by bigint [ref: > users.id]
  status intake_status_enum
  scheduled_at datetime
  confirmed_at datetime [note: 'nullable']
  note varchar [note: 'nullable']
}

Table notification_settings {
  user_id bigint [pk, ref: - users.id]
  medication_reminder_enabled boolean
  caregiver_alert_enabled boolean
  push_enabled boolean
  updated_at datetime
}

Table notifications {
  id bigint [pk, increment]
  medication_subject_id bigint [ref: > users.id]
  schedule_id bigint [ref: > medication_schedules.id, note: 'nullable']
  intake_id bigint [ref: > medication_intake_logs.id, note: 'nullable']
  type notification_type_enum
  payload "json"
  created_at datetime
}

Table notification_deliveries {
  id bigint [pk, increment]
  notification_id bigint [ref: > notifications.id]
  recipient_id bigint [ref: > users.id]
  delivered_at datetime [note: 'nullable']
  read_at datetime [note: 'nullable']
  acknowledged_at datetime [note: 'nullable']
}

Table education_profiles {
  id bigint [pk, increment]
  medication_subject_id bigint [ref: > users.id, note: 'UK with cycle_number']
  cycle_number int [note: 'UK with medication_subject_id']
  assigned_educator_id bigint [ref: > users.id, note: 'nullable']
  education_stage education_stage_enum
  education_started_at datetime
  tracking_ends_at datetime
  next_phone_support_at datetime [note: 'nullable']
  service_program varchar [note: 'nullable']
  eligibility_verified boolean
  status education_status_enum
  is_current boolean
  restart_reason varchar [note: 'nullable']
  ended_at datetime [note: 'nullable']
  created_at datetime
  updated_at datetime

  indexes {
    (medication_subject_id, cycle_number) [unique]
  }
}

Table education_support_logs {
  id bigint [pk, increment]
  education_profile_id bigint [ref: > education_profiles.id]
  educator_id bigint [ref: > users.id]
  support_type support_type_enum
  supported_at datetime
  note varchar [note: 'nullable']
}
