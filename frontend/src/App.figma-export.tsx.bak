const MED_LOGS: Record<string, { drug: string; time: string; status: string; checker: string }[]> = {
  "2025.07.07": [
    { drug: "암로디핀 5mg", time: "08:00", status: "복용완료", checker: "김철수" },
    { drug: "메트포르민 500mg", time: "08:00", status: "복용완료", checker: "본인" },
    { drug: "아스피린 100mg", time: "12:00", status: "미복용", checker: "—" },
  ],
  "2025.07.06": [
    { drug: "암로디핀 5mg", time: "08:00", status: "복용완료", checker: "본인" },
    { drug: "메트포르민 500mg", time: "08:00", status: "건너뜀", checker: "이영희" },
    { drug: "아스피린 100mg", time: "12:00", status: "복용완료", checker: "본인" },
  ],
  "2025.07.05": [
    { drug: "암로디핀 5mg", time: "08:00", status: "미복용", checker: "—" },
    { drug: "메트포르민 500mg", time: "08:00", status: "미복용", checker: "—" },
    { drug: "아스피린 100mg", time: "12:00", status: "미복용", checker: "—" },
  ],
  "2025.07.04": [
    { drug: "암로디핀 5mg", time: "08:00", status: "복용완료", checker: "본인" },
    { drug: "메트포르민 500mg", time: "08:00", status: "복용완료", checker: "본인" },
    { drug: "아스피린 100mg", time: "12:00", status: "복용완료", checker: "본인" },
  ],
  "2025.07.03": [
    { drug: "암로디핀 5mg", time: "08:00", status: "복용완료", checker: "본인" },
    { drug: "메트포르민 500mg", time: "08:00", status: "복용완료", checker: "본인" },
    { drug: "아스피린 100mg", time: "12:00", status: "복용완료", checker: "본인" },
  ],
  "2025.07.02": [
    { drug: "암로디핀 5mg", time: "08:00", status: "복용완료", checker: "본인" },
    { drug: "메트포르민 500mg", time: "08:00", status: "건너뜀", checker: "이영희" },
    { drug: "아스피린 100mg", time: "12:00", status: "복용완료", checker: "본인" },
  ],
  "2025.07.01": [
    { drug: "암로디핀 5mg", time: "08:00", status: "복용완료", checker: "본인" },
    { drug: "메트포르민 500mg", time: "08:00", status: "복용완료", checker: "본인" },
    { drug: "아스피린 100mg", time: "12:00", status: "복용완료", checker: "본인" },
  ],
};

interface PrescriptionRecord { id: number; date: string; diagnosis: string; drugs: string; proxy: string | null; }
const ALL_PRESCRIPTIONS: PrescriptionRecord[] = [
  { id: 1, date: "2025.06.25", diagnosis: "고혈압·당뇨 복합 처방", drugs: "암로디핀 5mg, 메트포르민 500mg, 아스피린 100mg", proxy: null },
  { id: 2, date: "2025.06.10", diagnosis: "이상지질혈증 단독 처방", drugs: "아토르바스타틴 20mg", proxy: "김철수" },
  { id: 3, date: "2025.05.20", diagnosis: "고혈압 정기 처방", drugs: "암로디핀 5mg, 로사르탄 50mg", proxy: null },
  { id: 4, date: "2025.04.15", diagnosis: "당뇨 관리 처방", drugs: "메트포르민 500mg, 아스피린 100mg", proxy: "이영희" },
];

function RecordsPage({ selectedDate, onNavigate, onSelectPrescription }: {
  selectedDate?: string | null;
  onNavigate?: (s: Screen) => void;
  onSelectPrescription?: (id: number) => void;
}) {
  const [search, setSearch] = useState("");
  const prescriptions = ALL_PRESCRIPTIONS;
  const filtered = prescriptions.filter((r) => !search || r.drugs.includes(search) || r.diagnosis.includes(search));

  const dayLogs = selectedDate ? (MED_LOGS[selectedDate] ?? []) : null;
  const ssLog = (s: string) => s === "복용완료" ? { bg: `${C.sage}20`, color: C.sage } : s === "건너뜀" ? { bg: "#F0EDE8", color: C.muted } : { bg: `${C.coral}20`, color: C.coral };

  return (
    <div style={{ background: C.ivory, minHeight: "100vh" }}>
      <Navbar loggedIn onNavigate={onNavigate} />
      <main className="max-w-2xl mx-auto px-8 pt-28 pb-24">
        {/* Date-filtered medication log view */}
        {selectedDate && dayLogs !== null && (
          <>
            <div className="flex items-center gap-3 mb-6">
              <button onClick={() => onNavigate?.("monitoring")}
                      className="flex items-center gap-1.5 text-[13px] font-bold hover:opacity-60 transition-opacity"
                      style={{ color: C.muted }}>
                ← 모니터링으로
              </button>
            </div>
            <div className="flex items-start justify-between mb-6">
              <div>
                <p className="text-[13px] font-bold mb-1" style={{ color: C.terracotta }}>날짜별 복약 기록</p>
                <h1 className="text-[28px] font-black" style={{ color: C.dark }}>
                  {selectedDate.replace(/\./g, "년 ").replace(" ", "").replace(".", "월 ").replace(".", "일")}
                </h1>
              </div>
              <div className="w-12 h-12 rounded-2xl flex items-center justify-center" style={{ background: `${C.terracotta}12` }}>
                <Clock className="w-6 h-6" style={{ color: C.terracotta }} />
              </div>
            </div>
            {dayLogs.length > 0 ? (
              <div className="rounded-2xl overflow-hidden mb-8" style={{ background: C.white, boxShadow: "0 2px 16px rgba(30,26,23,0.07)" }}>
                <table className="w-full">
                  <thead>
                    <tr style={{ borderBottom: `1px solid ${C.lightBorder}`, background: "#FAFAF7" }}>
                      {["약 이름", "복용 시각", "상태", "확인자"].map((h) => (
                        <th key={h} className="px-5 py-3 text-left text-[11px] font-bold uppercase tracking-wider" style={{ color: C.muted }}>{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {dayLogs.map((r, i) => {
                      const s = ssLog(r.status);
                      return (
                        <tr key={i} style={{ borderBottom: i < dayLogs.length - 1 ? `1px solid ${C.lightBorder}` : undefined }}>
                          <td className="px-5 py-4 font-bold text-[14px]" style={{ color: C.dark }}>{r.drug}</td>
                          <td className="px-5 py-4 text-[13px]" style={{ color: C.muted }}>{r.time}</td>
                          <td className="px-5 py-4"><span className="px-3 py-1 rounded-full text-[12px] font-bold" style={{ background: s.bg, color: s.color }}>{r.status}</span></td>
                          <td className="px-5 py-4 text-[13px]" style={{ color: C.muted }}>{r.checker}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            ) : (
              <div className="rounded-2xl p-10 text-center mb-8" style={{ background: C.white, boxShadow: "0 2px 16px rgba(30,26,23,0.07)" }}>
                <p className="text-[15px]" style={{ color: C.muted }}>해당 날짜의 복약 기록이 없습니다.</p>
              </div>
            )}
            <div className="h-px mb-8" style={{ background: "rgba(30,26,23,0.10)" }} />
            <h2 className="text-[18px] font-black mb-5" style={{ color: C.dark }}>전체 처방 기록</h2>
          </>
        )}

        {/* Default header — shown when no date selected */}
        {!selectedDate && (
          <>
            <h1 className="text-[28px] font-black mb-8" style={{ color: C.dark }}>이용 기록</h1>
            <div className="flex gap-3 mb-8">
              <div className="flex items-center gap-2 px-4 py-3 rounded-xl border bg-white flex-1" style={{ borderColor: "rgba(30,26,23,0.15)" }}>
                <Clock className="w-4 h-4 shrink-0" style={{ color: C.muted }} />
                <span className="text-[14px]" style={{ color: C.muted }}>2025.04.01</span>
                <span className="text-[13px] mx-1" style={{ color: C.muted }}>—</span>
                <span className="text-[14px]" style={{ color: C.muted }}>2025.07.07</span>
              </div>
              <div className="relative flex-1">
                <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4" style={{ color: C.muted }} />
                <input value={search} onChange={(e) => setSearch(e.target.value)} placeholder="약품명 검색"
                       className="w-full pl-10 pr-4 py-3 rounded-xl border text-[14px] outline-none bg-white" style={{ borderColor: "rgba(30,26,23,0.15)" }} />
              </div>
            </div>
          </>
        )}

        {/* Prescription records */}
        <div className="space-y-4">
          {filtered.map((r) => (
            <div key={r.id} className="rounded-2xl overflow-hidden" style={{ background: C.white, boxShadow: "0 2px 16px rgba(30,26,23,0.07)" }}>
              {r.proxy && (
                <div className="px-5 py-2.5 flex items-center gap-2" style={{ background: `${C.coral}10`, borderBottom: `1px solid ${C.coral}20` }}>
                  <Heart className="w-3.5 h-3.5" style={{ color: C.coral }} />
                  <p className="text-[12px] font-bold" style={{ color: C.coral }}>{r.proxy}님이 대신 올려드렸어요</p>
                </div>
              )}
              <div className="p-5">
                <div className="flex items-start justify-between mb-3">
                  <div><p className="text-[12px] mb-1" style={{ color: C.muted }}>업로드일 {r.date}</p><p className="text-[17px] font-black" style={{ color: C.dark }}>{r.diagnosis}</p></div>
                  <div className="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style={{ background: `${C.terracotta}12` }}><FileText className="w-5 h-5" style={{ color: C.terracotta }} /></div>
                </div>
                <p className="text-[13px] mb-4" style={{ color: C.muted }}>{r.drugs}</p>
                <div className="border-t pt-3 flex justify-end" style={{ borderColor: C.lightBorder }}>
                  <button onClick={() => { onSelectPrescription?.(r.id); onNavigate?.("prescription-detail"); }}
                          className="flex items-center gap-1 px-4 py-2 rounded-full text-[13px] font-bold transition-all hover:opacity-80"
                          style={{ background: `${C.terracotta}12`, color: C.terracotta }}>
                    자세히 보기 <ChevronRight className="w-3.5 h-3.5" />
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </main>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// SCREEN 11: MY PAGE — 마이페이지
// ══════════════════════════════════════════════════════════════════════════════
function MyPage({ onNavigate, fontSize, setFontSize }: {
  onNavigate: (s: Screen) => void;
  fontSize: FontSize;
  setFontSize: (f: FontSize) => void;
}) {
  const [withdrawModal, setWithdrawModal] = useState(false);
  const [fontModal, setFontModal] = useState(false);
  const [pendingFont, setPendingFont] = useState<FontSize>(fontSize);

  const FONT_OPTIONS: { key: FontSize; label: string; sub: string; px: number }[] = [
    { key: "small",  label: "소형", sub: "작게",   px: 14 },
    { key: "medium", label: "중형", sub: "보통",   px: 17 },
    { key: "large",  label: "대형", sub: "크게",   px: 21 },
  ];

  const menu = [
    { label: "글자 크기 설정", icon: "🔤", action: () => { setPendingFont(fontSize); setFontModal(true); } },
    { label: "알림 설정",      icon: "🔔", action: () => onNavigate("notification") },
    { label: "연결 관리",      icon: "👥", action: () => onNavigate("caregiver") },
    { label: "환자 관리",      icon: "🏥", action: () => onNavigate("patient-mgmt") },
    { label: "비밀번호 변경",  icon: "🔒", action: () => {} },
  ];

  return (
    <div style={{ background: C.ivory, minHeight: "100vh" }}>
      <Navbar loggedIn onNavigate={onNavigate} />
      <main className="max-w-xl mx-auto px-8 pt-28 pb-24">
        <h1 className="text-[28px] font-black mb-8" style={{ color: C.dark }}>마이페이지</h1>

        {/* Profile card */}
        <div className="rounded-2xl p-7 mb-6" style={{ background: C.white, boxShadow: "0 2px 20px rgba(30,26,23,0.07)" }}>
          <div className="flex items-center gap-5 mb-5">
            <div className="w-16 h-16 rounded-2xl flex items-center justify-center text-white text-2xl font-black shrink-0" style={{ background: C.terracotta }}>김</div>
            <div>
              <p className="text-[22px] font-black" style={{ color: C.dark }}>김건강</p>
              <span className="inline-block px-3 py-1 rounded-full text-[12px] font-bold mt-1" style={{ background: `${C.sage}20`, color: C.sage }}>복약관리 대상자</span>
            </div>
          </div>
          <div className="space-y-2.5 border-t pt-5" style={{ borderColor: C.lightBorder }}>
            {[{ label: "이메일", value: "kim@example.com" }, { label: "전화번호", value: "010-1234-5678" }, { label: "역할", value: "복약관리 대상자 (어르신)" }].map((row) => (
              <div key={row.label} className="flex items-center justify-between">
                <span className="text-[13px]" style={{ color: C.muted }}>{row.label}</span>
                <span className="text-[14px] font-semibold" style={{ color: C.dark }}>{row.value}</span>
              </div>
            ))}
          </div>
        </div>

        {/* Current font size indicator */}
        <div className="rounded-xl px-5 py-3 mb-4 flex items-center gap-2" style={{ background: `${C.terracotta}08`, border: `1px solid ${C.terracotta}25` }}>
          <span className="text-[14px]">🔤</span>
          <span className="text-[13px]" style={{ color: C.dark }}>현재 글자 크기: <strong style={{ color: C.terracotta }}>{FONT_OPTIONS.find(f => f.key === fontSize)?.label} ({FONT_OPTIONS.find(f => f.key === fontSize)?.sub})</strong></span>
        </div>

        {/* Menu */}
        <div className="rounded-2xl overflow-hidden mb-8" style={{ background: C.white, boxShadow: "0 2px 20px rgba(30,26,23,0.07)" }}>
          {menu.map(({ label, icon, action }) => (
            <button key={label} onClick={action}
                    className="w-full flex items-center justify-between px-6 py-4 hover:bg-gray-50 transition-colors border-b last:border-b-0"
                    style={{ borderColor: C.lightBorder }}>
              <div className="flex items-center gap-3">
                <div className="w-9 h-9 rounded-xl flex items-center justify-center text-[18px]" style={{ background: `${C.terracotta}12` }}>{icon}</div>
                <span className="text-[15px] font-semibold" style={{ color: C.dark }}>{label}</span>
              </div>
              <ChevronRight className="w-4 h-4" style={{ color: C.muted }} />
            </button>
          ))}
        </div>

        <button onClick={() => setWithdrawModal(true)}
                className="w-full py-3.5 rounded-full border-2 font-bold text-[15px] transition-colors hover:bg-red-50"
                style={{ borderColor: "rgba(193,101,61,0.3)", color: C.terracotta }}>
          회원 탈퇴
        </button>
      </main>

      {/* Font size modal */}
      {fontModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center px-4" style={{ background: "rgba(30,26,23,0.60)" }}
             onClick={() => setFontModal(false)}>
          <div className="rounded-3xl w-full max-w-sm overflow-hidden" style={{ background: C.white }} onClick={(e) => e.stopPropagation()}>
            {/* Header */}
            <div className="px-7 pt-7 pb-5 border-b" style={{ borderColor: C.lightBorder }}>
              <h3 className="text-[20px] font-black mb-1" style={{ color: C.dark }}>글자 크기 설정</h3>
              <p className="text-[13px]" style={{ color: C.muted }}>화면에 표시되는 글자 크기를 선택해주세요</p>
            </div>

            {/* Options */}
            <div className="px-7 py-5 space-y-3">
              {FONT_OPTIONS.map(({ key, label, sub, px }) => {
                const sel = pendingFont === key;
                return (
                  <button key={key} onClick={() => setPendingFont(key)}
                          className="w-full flex items-center justify-between px-4 py-4 rounded-2xl transition-all"
                          style={{ background: sel ? `${C.terracotta}08` : C.ivory, border: `2px solid ${sel ? C.terracotta : "rgba(30,26,23,0.10)"}` }}>
                    <div className="flex items-center gap-3">
                      <div className="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 transition-all"
                           style={{ borderColor: sel ? C.terracotta : "rgba(30,26,23,0.25)" }}>
                        {sel && <div className="w-2.5 h-2.5 rounded-full" style={{ background: C.terracotta }} />}
                      </div>
                      <div className="text-left">
                        <p className="font-black" style={{ color: sel ? C.terracotta : C.dark, fontSize: px }}>{label}</p>
                        <p className="text-[11px]" style={{ color: C.muted }}>{sub} ({px}px)</p>
                      </div>
                    </div>
                    {/* Preview */}
                    <div className="text-right">
                      <p style={{ fontSize: px, color: sel ? C.terracotta : C.muted, fontWeight: 700, lineHeight: 1.3 }}>가나다</p>
                      <p style={{ fontSize: Math.max(px - 4, 10), color: C.muted }}>복약 안내</p>
                    </div>
                  </button>
                );
              })}
            </div>

            {/* Preview */}
            <div className="mx-7 mb-5 p-4 rounded-2xl" style={{ background: C.ivory, border: "1px dashed rgba(30,26,23,0.15)" }}>
              <p className="text-[11px] font-bold mb-2 uppercase tracking-wider" style={{ color: C.muted }}>미리보기</p>
              <p style={{ fontSize: FONT_OPTIONS.find(f => f.key === pendingFont)!.px, color: C.dark, fontWeight: 700, lineHeight: 1.5 }}>
                오늘 복약해야 할 약이 3가지 있어요.
              </p>
              <p style={{ fontSize: FONT_OPTIONS.find(f => f.key === pendingFont)!.px - 2, color: C.muted, lineHeight: 1.6 }}>
                암로디핀 5mg · 아침 식후
              </p>
            </div>

            {/* Actions */}
            <div className="flex gap-3 px-7 pb-7">
              <button onClick={() => setFontModal(false)}
                      className="flex-1 py-3.5 rounded-full font-bold text-[15px] border-2"
                      style={{ borderColor: "rgba(30,26,23,0.15)", color: C.dark }}>
                취소
              </button>
              <button onClick={() => { setFontSize(pendingFont); setFontModal(false); }}
                      className="flex-[1.5] py-3.5 rounded-full font-bold text-white text-[15px] transition-all hover:opacity-88"
                      style={{ background: C.terracotta }}>
                저장
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Withdraw modal */}
      {withdrawModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center" style={{ background: "rgba(30,26,23,0.55)" }} onClick={() => setWithdrawModal(false)}>
          <div className="rounded-2xl p-8 max-w-sm w-full mx-4" style={{ background: C.white }} onClick={(e) => e.stopPropagation()}>
            <div className="w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-5" style={{ background: `${C.terracotta}15` }}><AlertCircle className="w-6 h-6" style={{ color: C.terracotta }} /></div>
            <h3 className="text-[20px] font-black text-center mb-3" style={{ color: C.dark }}>정말 탈퇴하시겠어요?</h3>
            <p className="text-[14px] text-center leading-relaxed mb-7" style={{ color: C.muted }}>탈퇴 시 <span className="font-bold" style={{ color: C.dark }}>30일간 데이터가 보관</span>되며 이후 복구할 수 없어요.</p>
            <div className="flex gap-3">
              <button onClick={() => setWithdrawModal(false)} className="flex-1 py-3.5 rounded-full font-bold border-2 text-[15px]" style={{ borderColor: "rgba(30,26,23,0.15)", color: C.dark }}>취소</button>
              <button className="flex-1 py-3.5 rounded-full font-bold text-white text-[15px]" style={{ background: C.terracotta }}>탈퇴 확인</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// SCREEN 12: CARE EDUCATION — 대상자 교육 관리
// ══════════════════════════════════════════════════════════════════════════════
interface Trainee { id: number; name: string; stage: StageType; nextCall: string; }

function CareEducationPage() {
  const trainees: Trainee[] = [
    { id: 1, name: "김건강", stage: "집중교육", nextCall: "2025.07.05" },
    { id: 2, name: "이복자", stage: "전화지원", nextCall: "2025.07.08" },
    { id: 3, name: "박순자", stage: "자립단계", nextCall: "2025.07.15" },
    { id: 4, name: "최길동", stage: "전화지원", nextCall: "2025.07.09" },
  ];
  const [selectedId, setSelectedId] = useState<number | null>(null);
  const [sType, setSType] = useState<SupportType>("전화");
  const [memo, setMemo] = useState("");
  const [saved, setSaved] = useState<Set<number>>(new Set());

  const stageStyle = (s: StageType) =>
    s === "집중교육" ? { bg: `${C.terracotta}18`, color: C.terracotta } :
    s === "전화지원" ? { bg: `${C.coral}18`, color: C.coral } :
    { bg: `${C.sage}18`, color: C.sage };

  return (
    <div style={{ background: C.ivory, minHeight: "100vh" }}>
      <Navbar loggedIn />
      <main className="max-w-4xl mx-auto px-8 pt-28 pb-24">
        <h1 className="text-[26px] font-black mb-2" style={{ color: C.dark }}>대상자 교육 관리</h1>
        <p className="text-[15px] mb-8" style={{ color: C.muted }}>배정된 대상자의 교육 진행 상황을 관리하고 지원 기록을 남겨주세요.</p>
        <div className="rounded-2xl overflow-hidden" style={{ background: C.white, boxShadow: "0 2px 20px rgba(30,26,23,0.07)" }}>
          <table className="w-full">
            <thead>
              <tr style={{ borderBottom: `1px solid ${C.lightBorder}` }}>
                {["이름", "교육 단계", "다음 전화지원 예정일", ""].map((h) => <th key={h} className="px-6 py-3 text-left text-[11px] font-bold uppercase tracking-wider" style={{ color: C.muted }}>{h}</th>)}
              </tr>
            </thead>
            <tbody>
              {trainees.map((t) => {
                const ss = stageStyle(t.stage);
                const isOpen = selectedId === t.id;
                return (
                  <Fragment key={t.id}>
                    <tr className="cursor-pointer hover:bg-gray-50 transition-colors"
                        style={{ borderBottom: `1px solid ${C.lightBorder}`, background: isOpen ? `${C.terracotta}04` : undefined }}
                        onClick={() => setSelectedId(isOpen ? null : t.id)}>
                      <td className="px-6 py-4 font-bold text-[15px]" style={{ color: C.dark }}>
                        {t.name}
                        {saved.has(t.id) && <span className="ml-2 text-[11px] font-bold px-2 py-0.5 rounded-full" style={{ background: `${C.sage}20`, color: C.sage }}>기록 완료</span>}
                      </td>
                      <td className="px-6 py-4"><span className="px-3 py-1.5 rounded-full text-[12px] font-black" style={{ background: ss.bg, color: ss.color }}>{t.stage}</span></td>
                      <td className="px-6 py-4 text-[14px]" style={{ color: C.muted }}>{t.nextCall}</td>
                      <td className="px-6 py-4">
                        <button onClick={(e) => { e.stopPropagation(); setSelectedId(isOpen ? null : t.id); }}
                                className="px-4 py-2 rounded-full text-[13px] font-bold border" style={{ borderColor: `${C.terracotta}35`, color: C.terracotta }}>
                          지원 기록 남기기
                        </button>
                      </td>
                    </tr>
                    {isOpen && (
                      <tr>
                        <td colSpan={4} className="px-6 py-5" style={{ background: `${C.terracotta}05`, borderBottom: `1px solid ${C.lightBorder}` }}>
                          <p className="text-[14px] font-black mb-4" style={{ color: C.dark }}>{t.name} 지원 기록</p>
                          <div className="flex gap-2 mb-4">
                            {(["앱 내", "전화", "방문"] as SupportType[]).map((type) => (
                              <button key={type} onClick={() => setSType(type)} className="px-5 py-2 rounded-full text-[13px] font-bold transition-all"
                                      style={{ background: sType === type ? C.terracotta : "#F0EDE8", color: sType === type ? C.white : C.muted }}>{type}</button>
                            ))}
                          </div>
                          <textarea value={memo} onChange={(e) => setMemo(e.target.value)} placeholder="지원 내용을 입력하세요..." rows={3}
                                    className="w-full px-4 py-3 rounded-xl border text-[14px] outline-none resize-none mb-4"
                                    style={{ borderColor: "rgba(30,26,23,0.15)", background: C.white }} />
                          <div className="flex justify-end gap-3">
                            <button onClick={() => setSelectedId(null)} className="px-5 py-2.5 rounded-full border font-bold text-[14px]" style={{ borderColor: "rgba(30,26,23,0.15)", color: C.dark }}>취소</button>
                            <button onClick={() => { setSaved((p) => new Set([...p, t.id])); setSelectedId(null); setMemo(""); }}
                                    className="px-5 py-2.5 rounded-full font-bold text-white text-[14px]" style={{ background: C.terracotta }}>저장</button>
                          </div>
                        </td>
                      </tr>
                    )}
                  </Fragment>
                );
              })}
            </tbody>
          </table>
        </div>
      </main>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// SCREEN 13: ACCOUNT LOCKED — 계정 잠금
// ══════════════════════════════════════════════════════════════════════════════
function LockedPage() {
  const [codeSent, setCodeSent] = useState(false);
  const [code, setCode] = useState(Array(6).fill(""));

  return (
    <div className="min-h-screen flex flex-col items-center justify-center" style={{ background: C.ivory }}>
      <Navbar />
      <div className="w-full max-w-sm pt-24 px-4">
        <div className="text-center mb-8">
          <div className="w-20 h-20 rounded-3xl flex items-center justify-center mx-auto mb-6" style={{ background: `${C.terracotta}15` }}>
            <Lock className="w-10 h-10" style={{ color: C.terracotta }} />
          </div>
          <h1 className="text-[28px] font-black mb-2" style={{ color: C.dark }}>계정이 잠겼어요</h1>
          <p className="text-[15px] leading-relaxed" style={{ color: C.muted }}>5회 연속 로그인 실패로<br />계정이 일시적으로 잠겼습니다.</p>
        </div>
        <div className="rounded-2xl p-6 mb-6 text-center" style={{ background: C.white, boxShadow: "0 2px 20px rgba(30,26,23,0.07)" }}>
          <p className="text-[13px] mb-2" style={{ color: C.muted }}>잠금 해제 예정 시각</p>
          <p className="text-[48px] font-black leading-none" style={{ color: C.dark }}>오후 2:35</p>
          <p className="text-[13px] mt-2" style={{ color: C.muted }}>2025년 7월 2일 (수)</p>
        </div>
        {!codeSent ? (
          <button onClick={() => setCodeSent(true)} className="w-full py-4 rounded-full text-white font-bold text-[16px] hover:opacity-85 mb-4" style={{ background: C.terracotta }}>등록된 연락처로 인증코드 받기</button>
        ) : (
          <div className="rounded-2xl p-6 mb-4" style={{ background: C.white, boxShadow: "0 2px 20px rgba(30,26,23,0.07)" }}>
            <p className="text-[14px] font-bold mb-3" style={{ color: C.dark }}>010-****-5678로 발송된 인증코드 입력</p>
            <div className="flex gap-2 mb-4">
              {code.map((_, i) => (
                <input key={i} maxLength={1} className="w-full h-12 text-center text-[22px] font-black rounded-xl border outline-none focus:ring-2 focus:ring-orange-200"
                       style={{ borderColor: "rgba(30,26,23,0.2)", background: "#FAFAF7", color: C.dark }}
                       value={code[i]}
                       onChange={(e) => { const n = [...code]; n[i] = e.target.value.slice(-1); setCode(n); }} />
              ))}
            </div>
            <button className="w-full py-3.5 rounded-full font-bold text-white text-[15px] hover:opacity-85" style={{ background: C.terracotta }}>확인</button>
          </div>
        )}
        <p className="text-center mt-4">
          <a href="#" className="text-[14px] font-bold underline" style={{ color: C.muted }}>비밀번호 재설정하기</a>
        </p>
      </div>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// SCREEN 14: OCR ERROR — 처방전 인식 실패
// ══════════════════════════════════════════════════════════════════════════════
function OcrErrorPage({ onNavigate }: { onNavigate: (s: Screen) => void }) {
  return (
    <div className="min-h-screen flex flex-col items-center justify-center" style={{ background: C.ivory }}>
      <Navbar loggedIn />
      <div className="w-full max-w-md pt-24 px-8 text-center">
        <div className="w-24 h-24 rounded-3xl flex items-center justify-center mx-auto mb-7" style={{ background: `${C.terracotta}10` }}>
          <FileText className="w-12 h-12" style={{ color: `${C.terracotta}70` }} />
        </div>
        <h1 className="text-[28px] font-black mb-3" style={{ color: C.dark }}>처방전을 인식하지 못했어요</h1>
        <p className="text-[15px] leading-relaxed mb-8" style={{ color: C.muted }}>사진이 흐리거나 잘린 경우 인식이 어려울 수 있어요.<br />아래 방법으로 다시 시도해보세요.</p>
        <div className="rounded-2xl p-5 mb-8 text-left" style={{ background: C.white, boxShadow: "0 2px 16px rgba(30,26,23,0.07)" }}>
          <p className="text-[12px] font-black mb-3 uppercase tracking-widest" style={{ color: C.muted }}>실패 가능 원인</p>
          {["이미지가 흐리거나 초점이 맞지 않은 경우", "처방전 일부가 잘려 나간 경우", "조명이 너무 어둡거나 반사가 심한 경우", "처방전이 구겨지거나 접혀 있는 경우"].map((r) => (
            <div key={r} className="flex items-start gap-2.5 mb-2.5 last:mb-0">
              <div className="w-1.5 h-1.5 rounded-full mt-2 shrink-0" style={{ background: C.coral }} />
              <p className="text-[13px]" style={{ color: C.dark }}>{r}</p>
            </div>
          ))}
        </div>
        <div className="flex flex-col gap-3">
          <button onClick={() => onNavigate("ocr-upload")} className="w-full py-4 rounded-full text-white font-bold text-[17px] hover:opacity-85 transition-opacity" style={{ background: C.terracotta }}>다시 업로드하기</button>
          <button onClick={() => onNavigate("ocr-review")} className="w-full py-4 rounded-full font-bold text-[17px] border-2 transition-colors hover:bg-gray-50"
                  style={{ borderColor: "rgba(30,26,23,0.2)", color: C.dark }}>직접 입력하기</button>
        </div>
      </div>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// DRUG DETAIL PAGE
// ══════════════════════════════════════════════════════════════════════════════
interface DrugInfo {
  dose: string; category: string; indication: string; howToTake: string;
  precautions: string[]; sideEffects: string[]; interactions: string[]; storage: string;
}
const DRUG_DB: Record<string, DrugInfo> = {
  "암로디핀 5mg": {
    dose: "1정 (5mg)", category: "칼슘채널차단제 (CCB)", indication: "고혈압, 안정형 협심증",
    howToTake: "하루 1회, 식사와 관계없이 복용하세요. 매일 같은 시간에 복용하는 것이 혈압 유지에 도움이 됩니다.",
    precautions: ["임의로 복용을 중단하지 마세요 — 혈압이 갑자기 오를 수 있어요", "자몽·자몽 주스와 함께 드시면 약효가 변할 수 있어요", "어지럼증이 있을 수 있으니 갑자기 일어서지 마세요", "임산부·수유부는 반드시 의사와 상담 후 복용하세요"],
    sideEffects: ["발목·발 부종", "두통", "안면 홍조", "어지러움", "심계항진", "피로감"],
    interactions: ["시클로스포린 (면역억제제)", "클라리스로마이신 (항생제)", "자몽 주스"],
    storage: "실온(15~25°C) 보관, 직사광선과 습기를 피하세요",
  },
  "메트포르민 500mg": {
    dose: "1정 (500mg)", category: "바이구아나이드계 혈당강하제", indication: "제2형 당뇨병",
    howToTake: "반드시 식사 직후에 복용하세요. 공복 복용 시 오심·구역감이 생길 수 있어요. 하루 2회(아침·저녁 식후) 복용합니다.",
    precautions: ["조영제 검사 전후 48시간은 복용을 중단하세요 (의사와 상담 필수)", "음주를 삼가세요 — 저혈당 위험이 높아져요", "신장 기능이 저하된 경우 용량 조절이 필요해요", "수술 전 의사에게 복용 사실을 반드시 알리세요"],
    sideEffects: ["식욕부진", "오심·구역", "설사", "복통", "금속성 맛 (일시적)"],
    interactions: ["알코올", "요오드 조영제", "세티리진 (항히스타민제)"],
    storage: "실온(15~25°C) 보관, 어린이 손이 닿지 않는 곳에 보관하세요",
  },
  "아스피린 100mg": {
    dose: "1정 (100mg)", category: "항혈소판제 / 비스테로이드성 소염제", indication: "혈전 예방, 심근경색·뇌졸중 재발 방지",
    howToTake: "하루 1회 식후에 복용하세요. 공복에 드시면 위장 장애가 생길 수 있어요.",
    precautions: ["수술·발치 전 최소 7일 전에는 의사와 상담 후 복용 중단 여부를 결정하세요", "이부프로펜 등 다른 소염진통제와 함께 복용하지 마세요", "위궤양, 출혈성 질환이 있는 분은 반드시 의사에게 알리세요", "술을 마신 날은 복용을 피하세요"],
    sideEffects: ["위장 불편감", "속쓰림", "출혈 시간 연장", "드물게: 이명, 두통"],
    interactions: ["이부프로펜 (NSAIDs)", "와파린 (항응고제)", "알코올"],
    storage: "실온(15~25°C) 보관, 습기를 피하세요",
  },
  "아토르바스타틴 20mg": {
    dose: "1정 (20mg)", category: "HMG-CoA 환원효소 억제제 (스타틴계)", indication: "고콜레스테롤혈증, 이상지질혈증, 심혈관 위험 감소",
    howToTake: "하루 1회 저녁 식후에 복용하세요. 콜레스테롤 합성이 주로 야간에 이루어지므로 저녁 복용이 효과적입니다.",
    precautions: ["근육통·근육 약화가 생기면 즉시 의사에게 알리세요 (드물게 횡문근융해증)", "자몽·자몽 주스와 함께 드시지 마세요", "간 기능 이상이 있는 경우 복용 전 반드시 상담하세요", "임산부·임신 계획 중인 여성은 복용 금지"],
    sideEffects: ["근육통", "소화장애", "두통", "간 효소 수치 상승 (드물게)", "피로감"],
    interactions: ["클라리스로마이신", "에리스로마이신", "자몽 주스", "니아신"],
    storage: "실온(15~25°C) 보관, 빛과 습기를 피하세요",
  },
};
const FALLBACK_DRUG: DrugInfo = {
  dose: "—", category: "—", indication: "담당 의사에게 문의하세요",
  howToTake: "처방 지시에 따라 복용하세요.", precautions: ["임의로 중단하지 마세요", "의사·약사와 상담 후 복용하세요"],
  sideEffects: ["이상 증상 발생 시 즉시 의사에게 알리세요"], interactions: ["복용 중인 다른 약과의 상호작용을 의사에게 확인하세요"],
  storage: "서늘하고 건조한 곳에 보관하세요",
};

function DrugDetailPage({ drug, onNavigate }: { drug: string | null; onNavigate: (s: Screen) => void }) {
  const name = drug ?? "약품 정보";
  const info = (drug && DRUG_DB[drug]) ? DRUG_DB[drug] : FALLBACK_DRUG;

  const sections: { icon: string; title: string; content: string | string[] }[] = [
    { icon: "💊", title: "복용 방법", content: info.howToTake },
    { icon: "⚠️", title: "주의사항", content: info.precautions },
    { icon: "🩺", title: "부작용", content: info.sideEffects },
    { icon: "🔗", title: "약물 상호작용", content: info.interactions },
    { icon: "📦", title: "보관 방법", content: info.storage },
  ];

  return (
    <div style={{ background: C.ivory, minHeight: "100vh", fontFamily: "'Noto Sans KR', sans-serif" }}>
      <Navbar loggedIn onNavigate={onNavigate} />
      <main className="max-w-2xl mx-auto px-8 pt-28 pb-24">
        {/* Back */}
        <button onClick={() => onNavigate("monitoring")}
                className="flex items-center gap-1.5 text-[13px] font-bold mb-6 hover:opacity-60 transition-opacity"
                style={{ color: C.muted }}>
          ← 모니터링으로 돌아가기
        </button>

        {/* Header card */}
        <div className="rounded-3xl p-7 mb-5" style={{ background: `linear-gradient(135deg, ${C.terracotta} 0%, #A5522F 100%)`, boxShadow: "0 8px 32px rgba(193,101,61,0.30)" }}>
          <div className="flex items-start gap-5">
            <div className="w-16 h-16 rounded-2xl flex items-center justify-center shrink-0 text-[32px]" style={{ background: "rgba(255,255,255,0.18)" }}>💊</div>
            <div className="flex-1">
              <p className="text-[13px] font-bold mb-1" style={{ color: "rgba(255,255,255,0.65)" }}>{info.category}</p>
              <h1 className="text-[26px] font-black leading-tight mb-2" style={{ color: C.white }}>{name}</h1>
              <div className="flex flex-wrap gap-2">
                <span className="px-3 py-1 rounded-full text-[12px] font-bold" style={{ background: "rgba(255,255,255,0.18)", color: C.white }}>용량 {info.dose}</span>
                <span className="px-3 py-1 rounded-full text-[12px] font-bold" style={{ background: "rgba(255,255,255,0.18)", color: C.white }}>적응증: {info.indication}</span>
              </div>
            </div>
          </div>
        </div>

        {/* Disclaimer */}
        <div className="flex items-start gap-2.5 px-4 py-3.5 rounded-2xl mb-5" style={{ background: "rgba(224,138,91,0.10)", border: "1px solid rgba(224,138,91,0.25)" }}>
          <span className="text-[14px] shrink-0">ℹ️</span>
          <p className="text-[12px] leading-relaxed" style={{ color: "#7A4B28" }}>아래 정보는 일반적인 복약 안내입니다. 개인 상태에 따라 다를 수 있으므로, 정확한 복약 지도는 담당 의사·약사에게 확인하세요.</p>
        </div>

        {/* Detail sections */}
        <div className="space-y-4">
          {sections.map(({ icon, title, content }) => (
            <div key={title} className="rounded-2xl p-6" style={{ background: C.white, boxShadow: "0 2px 12px rgba(30,26,23,0.06)" }}>
              <div className="flex items-center gap-2.5 mb-4">
                <span className="text-[18px]">{icon}</span>
                <h2 className="text-[15px] font-black" style={{ color: C.dark }}>{title}</h2>
              </div>
              {Array.isArray(content) ? (
                <ul className="space-y-2.5">
                  {content.map((item, i) => (
                    <li key={i} className="flex items-start gap-2.5">
                      <div className="w-1.5 h-1.5 rounded-full mt-1.5 shrink-0" style={{ background: title === "주의사항" ? C.coral : C.sage }} />
                      <p className="text-[14px] leading-relaxed" style={{ color: C.dark }}>{item}</p>
                    </li>
                  ))}
                </ul>
              ) : (
                <p className="text-[14px] leading-relaxed" style={{ color: C.dark }}>{content}</p>
              )}
            </div>
          ))}
        </div>

        {/* CTA */}
        <div className="mt-6 flex gap-3">
          <button onClick={() => onNavigate("chatbot")}
                  className="flex-1 py-4 rounded-full font-bold text-[15px] border-2 transition-all hover:bg-gray-50"
                  style={{ borderColor: C.terracotta, color: C.terracotta }}>
            챗봇에게 질문하기 💬
          </button>
          <button onClick={() => onNavigate("monitoring")}
                  className="flex-1 py-4 rounded-full font-bold text-[15px] text-white transition-all hover:opacity-88"
                  style={{ background: C.terracotta }}>
            확인 완료
          </button>
        </div>
      </main>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// SIGNUP FLOW (Steps 1–4 + Completion)
// ══════════════════════════════════════════════════════════════════════════════
type SignupMemberType = "personal" | "org";

interface NotificationSettingsProps {
  nPush: boolean; setNPush: React.Dispatch<React.SetStateAction<boolean>>;
  nSms: boolean; setNSms: React.Dispatch<React.SetStateAction<boolean>>;
  nEmail: boolean; setNEmail: React.Dispatch<React.SetStateAction<boolean>>;
}
function NotificationSettings({ nPush, setNPush, nSms, setNSms, nEmail, setNEmail }: NotificationSettingsProps) {
  const items = [
    { checked: nPush, set: setNPush, icon: "🔔", label: "Push 알림 허용", desc: "복약 시간, 건강 정보 앱 푸시 알림", required: true },
    { checked: nSms, set: setNSms, icon: "💬", label: "문자(SMS) 수신 허용", desc: "복약 안내·보호자 알림 문자 수신", required: false },
    { checked: nEmail, set: setNEmail, icon: "📧", label: "이메일 수신 허용", desc: "건강 뉴스레터, 서비스 공지 이메일", required: false },
  ] as { checked: boolean; set: React.Dispatch<React.SetStateAction<boolean>>; icon: string; label: string; desc: string; required: boolean }[];

  return (
    <div className="mt-5 pt-5 border-t" style={{ borderColor: "rgba(30,26,23,0.10)" }}>
      <div className="flex items-center gap-2 mb-3">
        <p className="text-[13px] font-black" style={{ color: C.dark }}>알림 수신 설정</p>
        <span className="px-2 py-0.5 rounded text-[10px] font-black" style={{ background: `${C.terracotta}15`, color: C.terracotta }}>Push 필수</span>
      </div>
      <div className="space-y-2">
        {items.map(({ checked, set, icon, label, desc, required }) => (
          <button key={label} onClick={() => { if (!required || !checked) set((p) => !p); }}
                  className="flex items-center gap-3 w-full px-4 py-3 rounded-xl transition-all text-left"
                  style={{ background: checked ? (required ? `${C.terracotta}08` : `${C.sage}10`) : "rgba(30,26,23,0.03)", border: `1.5px solid ${checked ? (required ? C.terracotta : C.sage) : "rgba(30,26,23,0.09)"}` }}>
            <div className="w-5 h-5 flex items-center justify-center shrink-0 transition-all"
                 style={{ background: checked ? (required ? C.terracotta : C.sage) : C.white, border: `2px solid ${checked ? (required ? C.terracotta : C.sage) : "rgba(30,26,23,0.2)"}`, borderRadius: 5 }}>
              {checked && <Check className="w-3 h-3 text-white" />}
            </div>
            <span className="text-[15px] shrink-0">{icon}</span>
            <div className="flex-1 min-w-0">
              <div className="flex items-center gap-1.5">
                <p className="text-[13px] font-bold" style={{ color: checked ? (required ? C.terracotta : "#4A7A47") : C.dark }}>{label}</p>
                {required && <span className="px-1.5 py-0.5 rounded text-[10px] font-black shrink-0" style={{ background: `${C.terracotta}15`, color: C.terracotta }}>필수</span>}
              </div>
              <p className="text-[11px]" style={{ color: C.muted }}>{desc}</p>
            </div>
          </button>
        ))}
      </div>
      {!nPush && (
        <p className="text-[12px] mt-2 flex items-center gap-1" style={{ color: C.coral }}>
          <AlertCircle className="w-3.5 h-3.5 shrink-0" />
          Push 알림은 복약 알림 서비스 이용을 위해 필수로 허용해주세요.
        </p>
      )}
    </div>
  );
}

function StepIndicator({ current }: { current: number }) {
  const steps = ["약관동의", "유형선택", "정보입력", "본인인증"];
  return (
    <div className="flex items-center justify-center mb-8">
      {steps.map((label, i) => {
        const n = i + 1;
        const active = n === current;
        const done = n < current;
        return (
          <Fragment key={n}>
            <div className="flex flex-col items-center gap-1.5">
              <div className="w-8 h-8 rounded-full flex items-center justify-center text-[13px] font-black transition-all"
                   style={{ background: active ? C.terracotta : done ? `${C.terracotta}22` : "rgba(30,26,23,0.09)", color: active ? C.white : done ? C.terracotta : C.muted }}>
                {done ? <Check className="w-4 h-4" /> : n}
              </div>
              <span className="text-[10px] font-bold whitespace-nowrap" style={{ color: active ? C.terracotta : C.muted }}>{label}</span>
            </div>
            {i < steps.length - 1 && (
              <div className="h-px mx-2 mb-5 shrink-0" style={{ width: 28, background: n < current ? `${C.terracotta}55` : "rgba(30,26,23,0.12)" }} />
            )}
          </Fragment>
        );
      })}
    </div>
  );
}

function SignupPage({ onNavigate }: { onNavigate: (s: Screen) => void }) {
  const [step, setStep] = useState(1);
  const [t1, setT1] = useState(false);
  const [t2, setT2] = useState(false);
  const [t3, setT3] = useState(false);
  const [t4, setT4] = useState(false);
  // Notification permissions
  const [nPush, setNPush] = useState(false);
  const [nSms, setNSms] = useState(false);
  const [nEmail, setNEmail] = useState(false);
  const [memberType, setMemberType] = useState<SignupMemberType | null>(null);
  const [pRole, setPRole] = useState<"patient" | "guardian">("patient");
  const [codeSent, setCodeSent] = useState(false);
  const [code, setCode] = useState("");
  const [done, setDone] = useState(false);

  const allChecked = t1 && t2 && t3 && t4;
  const requiredChecked = t1 && t2 && t3;

  function handleAllCheck() {
    const next = !allChecked;
    setT1(next); setT2(next); setT3(next); setT4(next);
  }

  const inputCss: React.CSSProperties = {
    background: C.ivory, border: "1.5px solid rgba(30,26,23,0.12)", borderRadius: 10,
    color: C.dark, width: "100%", padding: "14px 16px", fontSize: 15, outline: "none",
  };

  function renderStep1() {
    return (
      <>
        <h2 className="text-[22px] font-black mb-1.5 leading-snug" style={{ color: C.dark }}>
          서비스 이용을 위해<br />약관에 동의해주세요
        </h2>
        <p className="text-[14px] mb-6" style={{ color: C.muted }}>필수 항목 동의 후 서비스를 이용하실 수 있어요.</p>
        <button onClick={handleAllCheck}
                className="flex items-center gap-3 w-full px-4 py-4 rounded-2xl mb-3 transition-all"
                style={{ background: allChecked ? `${C.terracotta}06` : C.ivory, border: `1.5px solid ${allChecked ? C.terracotta : "rgba(30,26,23,0.12)"}` }}>
          <div className="w-6 h-6 rounded-md flex items-center justify-center shrink-0 transition-all"
               style={{ background: allChecked ? C.terracotta : C.white, border: `2px solid ${allChecked ? C.terracotta : "rgba(30,26,23,0.22)"}` }}>
            {allChecked && <Check className="w-3.5 h-3.5 text-white" />}
          </div>
          <span className="text-[16px] font-black" style={{ color: C.dark }}>전체 동의</span>
        </button>
        <div className="h-px mb-3" style={{ background: "rgba(30,26,23,0.08)" }} />
        {([
          { checked: t1, set: setT1, label: "서비스 이용약관 동의", badge: "필수", hasLink: true },
          { checked: t2, set: setT2, label: "개인정보 수집·이용 동의 (민감정보: 진료기록 포함)", badge: "필수", hasLink: true },
          { checked: t3, set: setT3, label: "만 14세 이상입니다", badge: "필수", hasLink: false },
          { checked: t4, set: setT4, label: "건강 정보 뉴스레터 수신 동의", badge: "선택", hasLink: false },
        ] as { checked: boolean; set: React.Dispatch<React.SetStateAction<boolean>>; label: string; badge: string; hasLink: boolean }[]).map(({ checked, set, label, badge, hasLink }) => (
          <div key={label} className="flex items-center gap-3 py-3 border-b last:border-0" style={{ borderColor: "rgba(30,26,23,0.07)" }}>
            <button onClick={() => set((p) => !p)}
                    className="w-5 h-5 flex items-center justify-center shrink-0 transition-all"
                    style={{ background: checked ? C.terracotta : C.white, border: `2px solid ${checked ? C.terracotta : "rgba(30,26,23,0.2)"}`, borderRadius: 5 }}>
              {checked && <Check className="w-3 h-3 text-white" />}
            </button>
            <span className="px-2 py-0.5 rounded text-[11px] font-black shrink-0"
                  style={{ background: badge === "필수" ? `${C.terracotta}15` : "rgba(30,26,23,0.08)", color: badge === "필수" ? C.terracotta : C.muted }}>
              {badge}
            </span>
            <span className="flex-1 text-[14px]" style={{ color: C.dark }}>{label}</span>
            {hasLink && <button className="text-[13px] font-bold shrink-0 hover:opacity-60" style={{ color: C.muted }}>보기 ›</button>}
          </div>
        ))}
        <button disabled={!requiredChecked} onClick={() => setStep(2)}
                className="w-full py-4 rounded-full text-white font-black text-[16px] mt-6 transition-all"
                style={{ background: requiredChecked ? C.terracotta : "#C8BFB8", cursor: requiredChecked ? "pointer" : "not-allowed" }}>
          동의하고 계속하기
        </button>
      </>
    );
  }

  function renderStep2() {
    return (
      <>
        <h2 className="text-[22px] font-black mb-1.5 leading-snug" style={{ color: C.dark }}>
          어떤 회원으로<br />가입하시나요?
        </h2>
        <p className="text-[14px] mb-6" style={{ color: C.muted }}>이용 목적에 맞는 유형을 선택해주세요.</p>
        <div className="grid grid-cols-2 gap-4 mb-6">
          {([
            { key: "personal" as const, icon: "👤", title: "개인", desc: "환자 본인 또는 보호자(가족)", tags: ["환자 본인", "보호자"] },
            { key: "org" as const, icon: "🏢", title: "단체·기관", desc: "요양보호사, 협회, 보건소 등 기관 소속", tags: ["요양보호사", "협회", "보건소"] },
          ]).map(({ key, icon, title, desc, tags }) => {
            const sel = memberType === key;
            return (
              <button key={key} onClick={() => setMemberType(key)}
                      className="flex flex-col items-start text-left p-5 rounded-2xl transition-all w-full"
                      style={{ background: sel ? `${C.terracotta}06` : C.white, border: `2px solid ${sel ? C.terracotta : "rgba(30,26,23,0.10)"}`, boxShadow: sel ? `0 4px 24px rgba(193,101,61,0.12)` : "0 2px 12px rgba(30,26,23,0.05)" }}>
                <span className="text-[38px] mb-3 leading-none">{icon}</span>
                <p className="text-[17px] font-black mb-1" style={{ color: sel ? C.terracotta : C.dark }}>{title}</p>
                <p className="text-[12px] leading-relaxed mb-3" style={{ color: C.muted }}>{desc}</p>
                <div className="flex flex-wrap gap-1.5">
                  {tags.map((t) => (
                    <span key={t} className="px-2.5 py-1 rounded-full text-[11px] font-bold"
                          style={{ background: sel ? `${C.terracotta}15` : "rgba(30,26,23,0.07)", color: sel ? C.terracotta : C.muted }}>
                      {t}
                    </span>
                  ))}
                </div>
              </button>
            );
          })}
        </div>
        <div className="flex gap-3">
          <button onClick={() => setStep(1)} className="flex-1 py-4 rounded-full font-bold text-[15px] border-2 hover:bg-gray-50 transition-colors" style={{ borderColor: "rgba(30,26,23,0.15)", color: C.dark }}>이전</button>
          <button disabled={!memberType} onClick={() => setStep(3)}
                  className="flex-[2] py-4 rounded-full text-white font-black text-[15px] transition-all"
                  style={{ background: memberType ? C.terracotta : "#C8BFB8", cursor: memberType ? "pointer" : "not-allowed" }}>
            다음
          </button>
        </div>
      </>
    );
  }

  function renderStep3() {
    if (memberType === "org") {
      return (
        <>
          <h2 className="text-[22px] font-black mb-1" style={{ color: C.dark }}>기관 정보를 입력해주세요</h2>
          <button onClick={() => setStep(2)} className="text-[13px] mb-5 block hover:opacity-60 transition-opacity" style={{ color: C.muted }}>← 이전</button>
          <div className="space-y-4">
            <div>
              <label className="block text-[13px] font-bold mb-1.5" style={{ color: C.dark }}>기관명</label>
              <input style={inputCss} placeholder="예: 행복요양원" />
            </div>
            <div>
              <label className="block text-[13px] font-bold mb-1.5" style={{ color: C.dark }}>기관 유형</label>
              <select style={inputCss} className="cursor-pointer">
                {["요양원", "재가센터", "협회", "보건소", "기타"].map((t) => <option key={t}>{t}</option>)}
              </select>
            </div>
            {[["사업자등록번호", "000-00-00000"], ["담당자 이름", "홍길동"], ["담당자 이메일", "manager@agency.com"], ["담당자 전화번호", "010-0000-0000"]].map(([label, ph]) => (
              <div key={label}>
                <label className="block text-[13px] font-bold mb-1.5" style={{ color: C.dark }}>{label}</label>
                <input style={inputCss} placeholder={ph} />
              </div>
            ))}
            <div>
              <label className="block text-[13px] font-bold mb-1.5" style={{ color: C.dark }}>비밀번호</label>
              <input type="password" style={inputCss} placeholder="비밀번호 입력" />
              <p className="text-[12px] mt-1.5" style={{ color: C.muted }}>8자 이상, 영문+숫자 조합</p>
            </div>
            <div>
              <label className="block text-[13px] font-bold mb-1.5" style={{ color: C.dark }}>비밀번호 확인</label>
              <input type="password" style={inputCss} placeholder="비밀번호 재입력" />
            </div>
          </div>
          {/* Notification settings — org */}
          <NotificationSettings nPush={nPush} setNPush={setNPush} nSms={nSms} setNSms={setNSms} nEmail={nEmail} setNEmail={setNEmail} />
          <button disabled={!nPush} onClick={() => setStep(4)}
                  className="w-full py-4 rounded-full text-white font-black text-[16px] mt-2 hover:opacity-88 transition-all"
                  style={{ background: nPush ? C.terracotta : "#C8BFB8", cursor: nPush ? "pointer" : "not-allowed" }}>
            다음 (본인인증)
          </button>
        </>
      );
    }
    return (
      <>
        <h2 className="text-[22px] font-black mb-1" style={{ color: C.dark }}>기본 정보를 입력해주세요</h2>
        <button onClick={() => setStep(2)} className="text-[13px] mb-5 block hover:opacity-60 transition-opacity" style={{ color: C.muted }}>← 이전</button>
        <div className="space-y-4">
          {[["이름", "홍길동", "text"], ["생년월일", "1945.03.15", "text"], ["이메일", "example@email.com", "email"], ["전화번호", "010-0000-0000", "tel"]].map(([label, ph, type]) => (
            <div key={label}>
              <label className="block text-[13px] font-bold mb-1.5" style={{ color: C.dark }}>{label}</label>
              <input type={type} style={inputCss} placeholder={ph} />
            </div>
          ))}
          <div>
            <label className="block text-[13px] font-bold mb-1.5" style={{ color: C.dark }}>비밀번호</label>
            <input type="password" style={inputCss} placeholder="비밀번호 입력" />
            <p className="text-[12px] mt-1.5" style={{ color: C.muted }}>8자 이상, 영문+숫자 조합</p>
          </div>
          <div>
            <label className="block text-[13px] font-bold mb-1.5" style={{ color: C.dark }}>비밀번호 확인</label>
            <input type="password" style={inputCss} placeholder="비밀번호 재입력" />
          </div>
          <div>
            <label className="block text-[13px] font-bold mb-2" style={{ color: C.dark }}>가입 유형</label>
            <div className="flex gap-3">
              {(["patient", "guardian"] as const).map((r) => (
                <button key={r} onClick={() => setPRole(r)}
                        className="flex items-center gap-2 px-5 py-3 rounded-full font-bold text-[14px] transition-all"
                        style={{ background: pRole === r ? C.terracotta : C.white, color: pRole === r ? C.white : C.dark, border: `1.5px solid ${pRole === r ? C.terracotta : "rgba(30,26,23,0.12)"}` }}>
                  <div className="w-4 h-4 rounded-full border-2 flex items-center justify-center shrink-0"
                       style={{ borderColor: pRole === r ? C.white : "rgba(30,26,23,0.3)" }}>
                    {pRole === r && <div className="w-2 h-2 rounded-full bg-white" />}
                  </div>
                  {r === "patient" ? "환자 본인" : "보호자(가족)"}
                </button>
              ))}
            </div>
          </div>
        </div>
        {/* Notification settings — personal */}
        <NotificationSettings nPush={nPush} setNPush={setNPush} nSms={nSms} setNSms={setNSms} nEmail={nEmail} setNEmail={setNEmail} />
        <button disabled={!nPush} onClick={() => setStep(4)}
                className="w-full py-4 rounded-full text-white font-black text-[16px] mt-2 transition-all"
                style={{ background: nPush ? C.terracotta : "#C8BFB8", cursor: nPush ? "pointer" : "not-allowed" }}>
          다음 (본인인증)
        </button>
      </>
    );
  }

  function renderStep4() {
    if (done) {
      return (
        <div className="text-center py-6">
          <div className="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6" style={{ background: `${C.sage}22` }}>
            <Check className="w-10 h-10" style={{ color: C.sage }} />
          </div>
          <h2 className="text-[26px] font-black mb-2" style={{ color: C.dark }}>가입이 완료되었어요!</h2>
          <p className="text-[15px] mb-8" style={{ color: C.muted }}>건강동행과 함께 건강한 일상을 시작해보세요</p>
          <button onClick={() => onNavigate("dashboard")}
                  className="w-full py-4 rounded-full text-white font-black text-[17px] hover:opacity-88 transition-all"
                  style={{ background: C.terracotta }}>
            시작하기
          </button>
        </div>
      );
    }
    return (
      <>
        <div className="text-center mb-6">
          <div className="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4" style={{ background: `${C.terracotta}12` }}>
            <Phone className="w-7 h-7" style={{ color: C.terracotta }} />
          </div>
          <h2 className="text-[22px] font-black mb-1" style={{ color: C.dark }}>휴대폰 본인인증</h2>
          <p className="text-[14px]" style={{ color: C.muted }}>가입하신 전화번호로 인증코드를 보내드려요</p>
        </div>
        <div className="flex items-center justify-between px-4 py-3.5 rounded-xl mb-4"
             style={{ background: C.ivory, border: "1.5px solid rgba(30,26,23,0.12)" }}>
          <span className="text-[16px] font-bold" style={{ color: C.dark }}>010-1234-5678</span>
          <button className="text-[13px] font-bold underline underline-offset-2 hover:opacity-60 transition-opacity" style={{ color: C.terracotta }}>수정</button>
        </div>
        <button onClick={() => setCodeSent(true)}
                className="w-full py-3.5 rounded-full text-white font-bold text-[15px] mb-5 hover:opacity-88 transition-all"
                style={{ background: C.terracotta }}>
          인증코드 받기
        </button>
        {codeSent && (
          <div className="mb-4">
            <label className="block text-[13px] font-bold mb-2" style={{ color: C.dark }}>인증코드 6자리</label>
            <div className="flex items-center gap-3">
              <input maxLength={6} value={code} onChange={(e) => setCode(e.target.value.replace(/\D/g, ""))}
                     placeholder="· · · · · ·"
                     className="flex-1 text-center text-[28px] font-black px-4 py-4 rounded-xl outline-none"
                     style={{ background: C.ivory, border: `2px solid ${code.length === 6 ? C.terracotta : "rgba(30,26,23,0.15)"}`, color: C.dark, letterSpacing: "0.5em" }} />
              <div className="shrink-0 font-black tabular-nums text-[18px]" style={{ color: C.terracotta, minWidth: 56, textAlign: "center" }}>02:47</div>
            </div>
            <p className="text-[13px] mt-2 text-center">
              <span style={{ color: C.muted }}>코드를 받지 못하셨나요? </span>
              <button className="font-bold underline underline-offset-2 hover:opacity-60 transition-opacity" style={{ color: C.terracotta }}>재전송</button>
            </p>
          </div>
        )}
        <button disabled={!codeSent || code.length !== 6} onClick={() => setDone(true)}
                className="w-full py-4 rounded-full text-white font-black text-[16px] mt-2 transition-all"
                style={{ background: (codeSent && code.length === 6) ? C.terracotta : "#C8BFB8", cursor: (codeSent && code.length === 6) ? "pointer" : "not-allowed" }}>
          인증 완료하고 가입하기
        </button>
      </>
    );
  }

  return (
    <div className="min-h-screen flex flex-col" style={{ background: C.ivory, fontFamily: "'Noto Sans KR', sans-serif" }}>
      <header className="w-full px-8 py-5 flex items-center">
        <button onClick={() => onNavigate("landing")} className="hover:opacity-70 transition-opacity"><Logo /></button>
      </header>
      <main className="flex-1 flex items-start justify-center px-4 py-6">
        <div className="w-full" style={{ maxWidth: 480 }}>
          {!(step === 4 && done) && <StepIndicator current={step} />}
          <div className="rounded-3xl p-8" style={{ background: C.white, boxShadow: "0 8px 40px rgba(30,26,23,0.10), 0 2px 8px rgba(30,26,23,0.06)" }}>
            {step === 1 && renderStep1()}
            {step === 2 && renderStep2()}
            {step === 3 && renderStep3()}
            {step === 4 && renderStep4()}
          </div>
        </div>
      </main>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// OCR UPLOAD PAGE
// ══════════════════════════════════════════════════════════════════════════════
function OcrUploadPage({ onNavigate }: { onNavigate: (s: Screen) => void }) {
  const [file, setFile] = useState<string | null>(null);
  const [dragging, setDragging] = useState(false);

  return (
    <div style={{ background: C.ivory, minHeight: "100vh", fontFamily: "'Noto Sans KR', sans-serif" }}>
      <Navbar loggedIn onNavigate={onNavigate} />
      <main className="max-w-2xl mx-auto px-8 pt-28 pb-24">
        <p className="text-[13px] font-bold mb-1" style={{ color: C.terracotta }}>복약 안내 만들기</p>
        <h1 className="text-[28px] font-black mb-1" style={{ color: C.dark }}>처방전을 올려주세요</h1>
        <p className="text-[15px] mb-8" style={{ color: C.muted }}>처방전이나 약봉투 사진을 올려주시면 복약 안내를 만들어드려요</p>

        <div className="grid grid-cols-2 gap-4 mb-5">
          {[
            { icon: "📷", title: "사진 바로 찍기", desc: "카메라로 처방전을 촬영해요" },
            { icon: "🖼", title: "앨범에서 선택", desc: "저장된 사진을 첨부해요" },
          ].map(({ icon, title, desc }) => (
            <button key={title} onClick={() => setFile("prescription_photo.jpg")}
                    className="flex flex-col items-center text-center p-7 rounded-2xl transition-all hover:shadow-md"
                    style={{ background: C.white, boxShadow: "0 2px 16px rgba(30,26,23,0.07)", border: "1.5px solid rgba(30,26,23,0.08)" }}>
              <span className="text-[44px] mb-3 leading-none">{icon}</span>
              <p className="text-[16px] font-black mb-1" style={{ color: C.dark }}>{title}</p>
              <p className="text-[13px]" style={{ color: C.muted }}>{desc}</p>
            </button>
          ))}
        </div>

        <div onDragOver={(e) => { e.preventDefault(); setDragging(true); }}
             onDragLeave={() => setDragging(false)}
             onDrop={(e) => { e.preventDefault(); setDragging(false); setFile("dropped_file.jpg"); }}
             className="rounded-2xl flex flex-col items-center justify-center py-10 mb-6 transition-all cursor-pointer"
             style={{ border: `2px dashed ${dragging ? C.terracotta : "rgba(30,26,23,0.2)"}`, background: dragging ? `${C.terracotta}05` : "transparent" }}>
          <FileText className="w-8 h-8 mb-3" style={{ color: dragging ? C.terracotta : C.muted }} />
          <p className="text-[14px]" style={{ color: C.muted }}>여기로 파일을 끌어다 놓아도 돼요</p>
        </div>

        <div className="rounded-2xl p-6 mb-6" style={{ background: "#FBF8F3", border: "1px solid rgba(30,26,23,0.08)" }}>
          <p className="text-[15px] font-black mb-4" style={{ color: C.dark }}>잘 인식되는 사진 팁</p>
          {["처방전 전체가 화면에 들어오게 찍어주세요", "밝은 곳에서 그림자 없이 찍어주세요", "처방전을 평평하게 펴주세요", "초점이 선명하게 맞은 뒤 촬영해주세요"].map((tip) => (
            <div key={tip} className="flex items-start gap-2.5 mb-2.5 last:mb-0">
              <Check className="w-4 h-4 shrink-0 mt-0.5" style={{ color: C.sage }} />
              <p className="text-[14px]" style={{ color: C.dark }}>{tip}</p>
            </div>
          ))}
        </div>

        {file && (
          <div className="rounded-2xl p-5 mb-5 flex items-center gap-4"
               style={{ background: C.white, border: `1.5px solid ${C.terracotta}40`, boxShadow: "0 2px 12px rgba(30,26,23,0.06)" }}>
            <div className="w-16 h-16 rounded-xl overflow-hidden shrink-0" style={{ background: "#EDE8DF" }}>
              <img src="https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=64&h=64&fit=crop&auto=format" alt="처방전 미리보기" className="w-full h-full object-cover" />
            </div>
            <div className="flex-1">
              <p className="text-[14px] font-bold" style={{ color: C.dark }}>{file}</p>
              <p className="text-[12px]" style={{ color: C.muted }}>JPEG · 2.4MB</p>
            </div>
            <button onClick={() => setFile(null)} className="w-8 h-8 rounded-full flex items-center justify-center hover:bg-gray-100 transition-colors" style={{ color: C.muted }}>
              <X className="w-4 h-4" />
            </button>
          </div>
        )}

        <button disabled={!file} onClick={() => onNavigate("ocr-review")}
                className="w-full py-4 rounded-full text-white font-black text-[17px] transition-all"
                style={{ background: file ? C.terracotta : "#C8BFB8", cursor: file ? "pointer" : "not-allowed" }}>
          업로드
        </button>
      </main>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// CHATBOT PAGE
// ══════════════════════════════════════════════════════════════════════════════
function ChatbotPage({ onNavigate }: { onNavigate: (s: Screen) => void }) {
  type ChatMsg = { role: "bot" | "user"; text: string; source?: string };
  const initMsgs: ChatMsg[] = [
    { role: "bot", text: "안녕하세요 😊 복약 안내 결과에 대해 궁금한 점을 물어보세요." },
    { role: "user", text: "이 약 밥 먹고 먹어도 되나요?" },
    { role: "bot", text: "네, 말씀하신 메트포르민 500mg은 반드시 식사 직후에 복용하셔야 합니다. 공복에 드시면 속이 불편하거나 구역감이 생길 수 있어요. 식사를 시작한 뒤 바로 드시거나, 식사 도중에 드셔도 괜찮습니다.", source: "출처: 식약처 e약은요" },
  ];
  const [messages, setMessages] = useState<ChatMsg[]>(initMsgs);
  const [input, setInput] = useState("");
  const suggested = ["이 약 식사 전에 먹어도 되나요?", "혈압약과 함께 먹어도 되나요?", "부작용이 있으면 어떻게 하나요?"];
  const bottomRef = useRef<HTMLDivElement>(null);
  const scrollAreaRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages]);

  function send(text: string) {
    if (!text.trim()) return;
    setMessages((p) => [
      ...p,
      { role: "user", text },
      { role: "bot", text: "죄송합니다, 현재 해당 질문을 처리 중입니다. 정확한 복약 지도는 담당 의사 또는 약사에게 확인해 주세요.", source: "출처: 식약처 e약은요" },
    ]);
    setInput("");
  }

  return (
    <div className="flex flex-col" style={{ background: C.ivory, minHeight: "100vh", fontFamily: "'Noto Sans KR', sans-serif" }}>
      <Navbar loggedIn onNavigate={onNavigate} />
      <main className="max-w-2xl mx-auto w-full px-4 pt-28 pb-6 flex flex-col" style={{ minHeight: "100vh" }}>
        <div className="mb-5">
          <p className="text-[13px] font-bold mb-1" style={{ color: C.terracotta }}>AI 복약 상담</p>
          <h1 className="text-[24px] font-black" style={{ color: C.dark }}>복약 상담 챗봇</h1>
          <p className="text-[14px]" style={{ color: C.muted }}>복약 안내 결과에 대해 궁금한 점을 물어보세요</p>
        </div>

        {/* Unified chat card: messages + suggested + input all in one white container */}
        <div className="rounded-3xl mb-4 flex flex-col overflow-hidden"
             style={{ background: C.white, boxShadow: "0 2px 20px rgba(30,26,23,0.07)" }}>

          {/* Scrollable message area */}
          <div ref={scrollAreaRef} className="flex-1 overflow-y-auto space-y-5 p-5" style={{ minHeight: 300, maxHeight: 400 }}>
            {messages.map((m, i) => (
              <div key={i} className={`flex items-end gap-3 ${m.role === "user" ? "flex-row-reverse" : ""}`}>
                {m.role === "bot" && (
                  <div className="w-9 h-9 rounded-full shrink-0 flex items-center justify-center text-[18px]" style={{ background: `${C.terracotta}12` }}>💊</div>
                )}
                <div className="max-w-[80%]">
                  <div className="px-4 py-3.5"
                       style={{ background: m.role === "user" ? C.terracotta : "#F4F0EA", color: m.role === "user" ? C.white : C.dark, fontSize: 15, lineHeight: 1.65, borderRadius: m.role === "user" ? "20px 20px 4px 20px" : "20px 20px 20px 4px" }}>
                    {m.text}
                  </div>
                  {m.source && <p className="text-[11px] mt-1.5 px-1" style={{ color: C.muted }}>{m.source}</p>}
                </div>
              </div>
            ))}
            <div ref={bottomRef} />
          </div>

          {/* Suggested questions */}
          <div className="flex gap-2 flex-wrap px-5 py-3 border-t" style={{ borderColor: "rgba(30,26,23,0.07)" }}>
            {suggested.map((q) => (
              <button key={q} onClick={() => send(q)}
                      className="px-3.5 py-2 rounded-full text-[13px] font-bold border transition-all hover:opacity-80"
                      style={{ borderColor: `${C.terracotta}50`, color: C.terracotta, background: `${C.terracotta}06` }}>
                {q}
              </button>
            ))}
          </div>

          {/* Input row — visually flush inside the card */}
          <div className="flex gap-2 px-4 py-4 border-t" style={{ borderColor: "rgba(30,26,23,0.07)" }}>
            <input value={input} onChange={(e) => setInput(e.target.value)}
                   onKeyDown={(e) => e.key === "Enter" && send(input)}
                   placeholder="궁금한 점을 입력해주세요"
                   className="flex-1 px-5 py-3.5 rounded-full text-[15px] outline-none"
                   style={{ background: C.ivory, border: "1.5px solid rgba(30,26,23,0.10)", color: C.dark }} />
            <button onClick={() => send(input)}
                    className="px-7 py-3.5 rounded-full text-white font-bold text-[15px] shrink-0 transition-all hover:opacity-88"
                    style={{ background: C.terracotta }}>
              전송
            </button>
          </div>
        </div>

        <div className="rounded-2xl px-5 py-4 flex items-start gap-2.5"
             style={{ background: "rgba(224,138,91,0.10)", border: "1px solid rgba(224,138,91,0.22)", color: "#7A4B28" }}>
          <span className="text-[15px] shrink-0">⚠️</span>
          <span className="text-[13px] leading-relaxed">
            챗봇 답변은 AI가 생성한 참고용 정보입니다. 정확한 복약 지도는 담당 의사 또는 약사에게 확인하세요.
          </span>
        </div>
      </main>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// LOGIN PAGE
// ══════════════════════════════════════════════════════════════════════════════
function LoginPage({ onNavigate }: { onNavigate: (s: Screen) => void }) {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [showPw, setShowPw] = useState(false);
  const [attempts, setAttempts] = useState(1); // starts at 1 to show error state per spec
  const hasError = attempts > 0;

  function handleLogin() {
    if (attempts >= 5) {
      onNavigate("locked");
      return;
    }
    setAttempts((n) => n + 1);
  }

  return (
    <div
      className="min-h-screen flex flex-col"
      style={{
        background: `radial-gradient(ellipse 90% 70% at 60% -10%, rgba(193,101,61,0.12) 0%, transparent 55%), ${C.ivory}`,
        fontFamily: "'Noto Sans KR', sans-serif",
      }}
    >
      {/* Slim top bar with logo */}
      <header className="w-full px-8 py-5 flex items-center">
        <button onClick={() => onNavigate("landing")} className="hover:opacity-70 transition-opacity">
          <Logo />
        </button>
      </header>

      {/* Centered card */}
      <main className="flex-1 flex items-center justify-center px-4 py-12">
        <div className="w-full" style={{ maxWidth: 480 }}>
          {/* Card */}
          <div
            className="rounded-3xl p-10"
            style={{
              background: C.white,
              boxShadow: "0 8px 40px rgba(30,26,23,0.10), 0 2px 8px rgba(30,26,23,0.06)",
            }}
          >
            {/* Heading */}
            <div className="mb-8">
              <h1
                className="font-black mb-1"
                style={{ fontSize: 32, color: C.dark, letterSpacing: "-0.5px" }}
              >
                안녕하세요
              </h1>
              <p className="text-[15px] font-medium" style={{ color: C.muted }}>
                건강동행에 로그인해 주세요
              </p>
            </div>

            {/* Email field */}
            <div className="mb-4">
              <label className="block text-[14px] font-bold mb-2" style={{ color: C.dark }}>
                이메일 또는 전화번호
              </label>
              <input
                type="text"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                placeholder="example@email.com"
                className="w-full px-4 py-3.5 text-[15px] outline-none transition-all"
                style={{
                  background: C.ivory,
                  border: `1.5px solid ${hasError ? "transparent" : "rgba(30,26,23,0.12)"}`,
                  borderRadius: 10,
                  color: C.dark,
                }}
                onFocus={(e) => { e.currentTarget.style.borderColor = C.terracotta; e.currentTarget.style.boxShadow = `0 0 0 3px rgba(193,101,61,0.10)`; }}
                onBlur={(e) => { e.currentTarget.style.borderColor = hasError ? "transparent" : "rgba(30,26,23,0.12)"; e.currentTarget.style.boxShadow = "none"; }}
              />
            </div>

            {/* Password field */}
            <div className="mb-1">
              <label className="block text-[14px] font-bold mb-2" style={{ color: C.dark }}>
                비밀번호
              </label>
              <div className="relative">
                <input
                  type={showPw ? "text" : "password"}
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  placeholder="비밀번호를 입력해 주세요"
                  className="w-full px-4 py-3.5 text-[15px] outline-none transition-all pr-12"
                  style={{
                    background: hasError ? "rgba(220,53,69,0.04)" : C.ivory,
                    border: `1.5px solid ${hasError ? "#E85C6A" : "rgba(30,26,23,0.12)"}`,
                    borderRadius: 10,
                    color: C.dark,
                  }}
                  onFocus={(e) => { e.currentTarget.style.borderColor = hasError ? "#E85C6A" : C.terracotta; e.currentTarget.style.boxShadow = hasError ? "0 0 0 3px rgba(232,92,106,0.10)" : `0 0 0 3px rgba(193,101,61,0.10)`; }}
                  onBlur={(e) => { e.currentTarget.style.borderColor = hasError ? "#E85C6A" : "rgba(30,26,23,0.12)"; e.currentTarget.style.boxShadow = "none"; }}
                />
                <button
                  type="button"
                  onClick={() => setShowPw((v) => !v)}
                  className="absolute right-4 top-1/2 -translate-y-1/2 transition-opacity hover:opacity-60"
                  style={{ color: C.muted }}
                >
                  {showPw ? <EyeOff className="w-4 h-4" /> : <Eye className="w-4 h-4" />}
                </button>
              </div>
            </div>

            {/* Error message — always shown per spec */}
            <div className="flex items-center gap-1.5 mt-2 mb-5">
              <AlertCircle className="w-3.5 h-3.5 shrink-0" style={{ color: "#E85C6A" }} />
              <p style={{ fontSize: 13, color: "#E85C6A", lineHeight: 1.4 }}>
                이메일 또는 비밀번호를 확인해주세요.{" "}
                <span style={{ color: "#C1453A", fontWeight: 700 }}>
                  ({attempts}/5회 실패)
                </span>
              </p>
            </div>

            {/* Login CTA */}
            <button
              onClick={handleLogin}
              className="w-full py-4 rounded-full text-white font-black text-[16px] tracking-wide transition-all hover:opacity-88 active:scale-[0.985]"
              style={{ background: C.terracotta, letterSpacing: "0.3px" }}
            >
              로그인
            </button>

            {/* Divider */}
            <div className="flex items-center gap-3 my-5">
              <div className="flex-1 h-px" style={{ background: "rgba(30,26,23,0.10)" }} />
              <span className="text-[12px] font-medium" style={{ color: C.muted }}>또는</span>
              <div className="flex-1 h-px" style={{ background: "rgba(30,26,23,0.10)" }} />
            </div>

            {/* Sign up outline button */}
            <button
              onClick={() => onNavigate("signup")}
              className="w-full py-4 rounded-full font-bold text-[16px] border-2 transition-all hover:bg-[rgba(193,101,61,0.05)] active:scale-[0.985]"
              style={{ borderColor: C.terracotta, color: C.terracotta }}
            >
              처음 오셨나요? <span className="underline underline-offset-2">회원가입</span>
            </button>

            {/* Forgot password */}
            <div className="text-center mt-6">
              <button
                className="text-[13px] underline underline-offset-2 transition-opacity hover:opacity-60"
                style={{ color: C.muted }}
              >
                비밀번호를 잊으셨나요?
              </button>
            </div>
          </div>

          {/* Trust badge below card */}
          <div className="flex items-center justify-center gap-2 mt-6">
            <ShieldCheck className="w-4 h-4 shrink-0" style={{ color: C.sage }} />
            <p className="text-[12px]" style={{ color: C.muted }}>
              회원님의 진료 정보는 안전하게 보호됩니다
            </p>
          </div>

          {/* Attempt count hint */}
          {attempts >= 4 && (
            <div
              className="mt-4 rounded-2xl px-5 py-4 flex items-start gap-3"
              style={{ background: "rgba(220,53,69,0.06)", border: "1px solid rgba(220,53,69,0.15)" }}
            >
              <Lock className="w-4 h-4 mt-0.5 shrink-0" style={{ color: "#E85C6A" }} />
              <p className="text-[12px] leading-relaxed" style={{ color: "#C1453A" }}>
                로그인 실패가 <strong>{attempts}회</strong> 누적되었습니다. 1회 더 실패하면 계정이 잠깁니다.
              </p>
            </div>
          )}
        </div>
      </main>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// PRESCRIPTION DETAIL PAGE
// ══════════════════════════════════════════════════════════════════════════════
const DISEASE_INFO: Record<string, { icon: string; summary: string; causes: string; management: string }> = {
  "고혈압": { icon: "🫀", summary: "혈압이 지속적으로 높은 상태(140/90mmHg 이상)로, 혈관과 심장에 부담을 줍니다.", causes: "유전적 요인, 염분 과다 섭취, 비만, 스트레스, 운동 부족이 주요 원인입니다.", management: "저염식 식단, 규칙적 운동, 체중 조절, 금연·절주와 함께 처방약을 규칙적으로 복용하세요." },
  "제2형 당뇨병": { icon: "🩸", summary: "인슐린 저항성으로 혈당이 만성적으로 높은 상태입니다. 합병증 예방이 중요합니다.", causes: "과체중·비만, 운동 부족, 고탄수화물 식단, 가족력이 발병 위험을 높입니다.", management: "혈당 자가 측정, 탄수화물 섭취 조절, 규칙적인 유산소 운동, 처방 혈당강하제 복용이 핵심입니다." },
  "이상지질혈증": { icon: "🩺", summary: "혈중 콜레스테롤·중성지방이 비정상적으로 높아 동맥경화·심혈관 질환 위험을 높입니다.", causes: "포화지방 과다 섭취, 운동 부족, 비만, 유전적 요인, 당뇨·갑상선 질환이 영향을 미칩니다.", management: "포화지방·트랜스지방 제한, 등푸른 생선·식이섬유 섭취 증가, 규칙적인 운동과 스타틴계 약물 복용이 필요합니다." },
  "협심증": { icon: "💗", summary: "심장 근육에 혈액 공급이 일시적으로 부족해 가슴 통증·압박감이 생기는 상태입니다.", causes: "관상동맥 협착, 동맥경화, 고혈압·당뇨·흡연이 위험 요인입니다.", management: "무거운 물건 들기·갑작스런 운동을 삼가고, 처방약을 항상 휴대하며 흉통 시 즉시 복용·병원 방문하세요." },
};

function getDiseases(diagnosis: string): string[] {
  const map: Record<string, string[]> = {
    "고혈압·당뇨 복합 처방": ["고혈압", "제2형 당뇨병"],
    "이상지질혈증 단독 처방": ["이상지질혈증"],
    "고혈압 정기 처방": ["고혈압"],
    "당뇨 관리 처방": ["제2형 당뇨병"],
  };
  return map[diagnosis] ?? ["고혈압"];
}

function PrescriptionDetailPage({ prescriptionId, onNavigate }: { prescriptionId: number | null; onNavigate: (s: Screen) => void }) {
  const rx = ALL_PRESCRIPTIONS.find((p) => p.id === prescriptionId) ?? ALL_PRESCRIPTIONS[0];
  const diseases = getDiseases(rx.diagnosis);
  const drugList = rx.drugs.split(", ");

  return (
    <div style={{ background: C.ivory, minHeight: "100vh", fontFamily: "'Noto Sans KR', sans-serif" }}>
      <Navbar loggedIn onNavigate={onNavigate} />
      <main className="max-w-2xl mx-auto px-8 pt-28 pb-24">
        <button onClick={() => onNavigate("records")}
                className="flex items-center gap-1.5 text-[13px] font-bold mb-6 hover:opacity-60 transition-opacity"
                style={{ color: C.muted }}>← 이용 기록으로</button>

        {/* Header */}
        <div className="rounded-3xl p-7 mb-5" style={{ background: `linear-gradient(135deg, #2C2318 0%, #1E1A17 100%)`, boxShadow: "0 8px 32px rgba(30,26,23,0.25)" }}>
          <p className="text-[13px] mb-2" style={{ color: "rgba(255,255,255,0.5)" }}>처방일 {rx.date}{rx.proxy ? ` · ${rx.proxy}님이 등록` : ""}</p>
          <h1 className="text-[24px] font-black mb-3" style={{ color: C.white }}>{rx.diagnosis}</h1>
          <div className="flex flex-wrap gap-2">
            {drugList.map((d) => (
              <span key={d} className="px-3 py-1 rounded-full text-[12px] font-bold" style={{ background: "rgba(255,255,255,0.12)", color: C.white }}>{d}</span>
            ))}
          </div>
        </div>

        {/* Disease sections */}
        <h2 className="text-[16px] font-black mb-4" style={{ color: C.dark }}>병명별 설명</h2>
        <div className="space-y-4 mb-8">
          {diseases.map((d) => {
            const info = DISEASE_INFO[d];
            if (!info) return null;
            return (
              <div key={d} className="rounded-2xl p-6" style={{ background: C.white, boxShadow: "0 2px 12px rgba(30,26,23,0.07)" }}>
                <div className="flex items-center gap-2.5 mb-4">
                  <span className="text-[22px]">{info.icon}</span>
                  <h3 className="text-[16px] font-black" style={{ color: C.dark }}>{d}</h3>
                </div>
                <p className="text-[14px] leading-relaxed mb-3" style={{ color: C.dark }}>{info.summary}</p>
                {[{ label: "주요 원인", text: info.causes }, { label: "관리 방법", text: info.management }].map(({ label, text }) => (
                  <div key={label} className="mt-3 pt-3 border-t" style={{ borderColor: "rgba(30,26,23,0.07)" }}>
                    <p className="text-[11px] font-black uppercase tracking-wider mb-1" style={{ color: C.muted }}>{label}</p>
                    <p className="text-[13px] leading-relaxed" style={{ color: C.dark }}>{text}</p>
                  </div>
                ))}
              </div>
            );
          })}
        </div>

        {/* Drug cards */}
        <h2 className="text-[16px] font-black mb-4" style={{ color: C.dark }}>처방 약물 정보</h2>
        <div className="space-y-3 mb-8">
          {drugList.map((drugName) => {
            const info = DRUG_DB[drugName];
            return (
              <div key={drugName} className="rounded-2xl p-5 flex items-start gap-4 cursor-pointer transition-all hover:shadow-md"
                   style={{ background: C.white, boxShadow: "0 2px 12px rgba(30,26,23,0.06)", border: "1.5px solid rgba(30,26,23,0.07)" }}
                   onClick={() => { onNavigate("drug-detail"); }}>
                <div className="w-11 h-11 rounded-xl flex items-center justify-center shrink-0 text-[20px]" style={{ background: `${C.terracotta}12` }}>💊</div>
                <div className="flex-1 min-w-0">
                  <div className="flex items-center justify-between mb-1">
                    <p className="font-black text-[15px]" style={{ color: C.dark }}>{drugName}</p>
                    <ChevronRight className="w-4 h-4 shrink-0" style={{ color: C.muted }} />
                  </div>
                  {info ? (
                    <>
                      <p className="text-[12px] mb-1" style={{ color: C.muted }}>{info.category}</p>
                      <p className="text-[13px]" style={{ color: C.dark }}>{info.howToTake.slice(0, 60)}…</p>
                    </>
                  ) : (
                    <p className="text-[13px]" style={{ color: C.muted }}>상세 정보를 확인하려면 탭하세요</p>
                  )}
                </div>
              </div>
            );
          })}
        </div>

        {/* CTA */}
        <button onClick={() => onNavigate("med-guide")}
                className="w-full py-4 rounded-full text-white font-black text-[16px] hover:opacity-88 transition-all"
                style={{ background: C.terracotta }}>
          이 처방전 복약 가이드 보기
        </button>
      </main>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// MEDICATION GUIDE PAGE
// ══════════════════════════════════════════════════════════════════════════════
function MedGuidePage({ onNavigate }: { onNavigate: (s: Screen) => void }) {
  const [activeTab, setActiveTab] = useState(0);
  const tabs = ["복약 일정", "병명 설명", "주의사항", "생활습관"];

  // Mock guide based on confirmed OCR cards: 고혈압 + 제2형 당뇨병 + 이상지질혈증
  const schedule = [
    { time: "아침 식후 08:00", drugs: [{ name: "암로디핀 5mg", note: "혈압약, 매일 동일 시간" }, { name: "메트포르민 500mg", note: "혈당약, 식사 직후 필수" }] },
    { time: "점심 식후 12:00", drugs: [{ name: "아스피린 100mg", note: "혈전 예방, 공복 금지" }] },
    { time: "저녁 식후 19:00", drugs: [{ name: "메트포르민 500mg", note: "혈당약, 식사 직후 필수" }, { name: "아토르바스타틴 20mg", note: "콜레스테롤약, 저녁 권장" }] },
  ];

  const diseases = [
    { name: "고혈압", info: DISEASE_INFO["고혈압"] },
    { name: "제2형 당뇨병", info: DISEASE_INFO["제2형 당뇨병"] },
    { name: "이상지질혈증", info: DISEASE_INFO["이상지질혈증"] },
  ];

  const precautions = [
    { icon: "🚫", title: "절대 금지", items: ["자몽·자몽 주스 — 암로디핀·아토르바스타틴 효과 변화", "임의로 복용 중단 — 혈압·혈당 급격히 악화될 수 있어요", "조영제 검사 48시간 전후 메트포르민 복용"] },
    { icon: "⚠️", title: "주의 사항", items: ["음주 시 저혈당·저혈압 위험이 높아져요", "아스피린 복용 중 다른 소염진통제 병용 금지", "두통·어지럼증·근육통이 지속되면 즉시 병원 방문"] },
    { icon: "💊", title: "복용 원칙", items: ["모든 약은 충분한 물(150mL 이상)과 함께 복용하세요", "빠뜨렸을 때는 생각난 즉시 복용, 다음 복용 시간이 가까우면 건너뛰세요", "처방 용량을 임의로 늘리거나 줄이지 마세요"] },
  ];

  const lifestyle = [
    {
      category: "식단 관리", icon: "🥗",
      items: [
        { label: "저염식", desc: "하루 소금 5g 미만 — 국물·찌개 대신 찜·구이 위주로" },
        { label: "저당식", desc: "흰 쌀밥·빵·단 음료 줄이고 잡곡밥·통곡물로 대체" },
        { label: "콜레스테롤 조절", desc: "삼겹살·버터·치즈 줄이고 등푸른 생선(고등어·연어) 주 2~3회" },
        { label: "채소·식이섬유", desc: "식사마다 채소 200g 이상, 혈당·콜레스테롤 수치 안정에 도움" },
      ],
    },
    {
      category: "운동", icon: "🚶",
      items: [
        { label: "유산소 운동", desc: "빠르게 걷기·자전거·수영 — 주 5일, 1회 30분 이상" },
        { label: "강도 조절", desc: "혈압이 180/110 이상이면 격렬한 운동 삼가고 의사와 상담" },
        { label: "근력 운동", desc: "가벼운 아령·밴드 운동 주 2~3회 — 혈당 개선에 효과적" },
        { label: "운동 전 혈당 확인", desc: "70mg/dL 미만이면 운동 전 간식 섭취 후 진행" },
      ],
    },
    {
      category: "생활 습관", icon: "🌙",
      items: [
        { label: "금연", desc: "흡연은 혈압·혈당·콜레스테롤 모두 악화 — 금연 클리닉 이용 추천" },
        { label: "절주", desc: "맥주 1캔 이상 음주 시 혈압·혈당 조절 어려워짐" },
        { label: "규칙적인 수면", desc: "수면 부족은 혈당 상승 및 혈압 불안정을 유발, 7~8시간 권장" },
        { label: "스트레스 관리", desc: "명상·복식호흡·산책으로 코르티솔 수치 낮추기" },
      ],
    },
  ];

  const tabContent = () => {
    if (activeTab === 0) return (
      <div className="space-y-4">
        {schedule.map((slot) => (
          <div key={slot.time} className="rounded-2xl overflow-hidden" style={{ background: C.white, boxShadow: "0 2px 12px rgba(30,26,23,0.07)" }}>
            <div className="px-5 py-3 flex items-center gap-2.5" style={{ background: `${C.terracotta}10`, borderBottom: `1px solid ${C.terracotta}20` }}>
              <Clock className="w-4 h-4" style={{ color: C.terracotta }} />
              <p className="text-[14px] font-black" style={{ color: C.terracotta }}>{slot.time}</p>
            </div>
            <div className="p-4 space-y-3">
              {slot.drugs.map((d) => (
                <div key={d.name} className="flex items-center gap-3">
                  <div className="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 text-[16px]" style={{ background: `${C.terracotta}10` }}>💊</div>
                  <div>
                    <p className="text-[14px] font-bold" style={{ color: C.dark }}>{d.name}</p>
                    <p className="text-[12px]" style={{ color: C.muted }}>{d.note}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    );
    if (activeTab === 1) return (
      <div className="space-y-4">
        {diseases.map(({ name, info }) => info && (
          <div key={name} className="rounded-2xl p-6" style={{ background: C.white, boxShadow: "0 2px 12px rgba(30,26,23,0.07)" }}>
            <div className="flex items-center gap-2.5 mb-3">
              <span className="text-[20px]">{info.icon}</span>
              <h3 className="text-[16px] font-black" style={{ color: C.dark }}>{name}</h3>
            </div>
            <p className="text-[14px] leading-relaxed mb-3" style={{ color: C.dark }}>{info.summary}</p>
            <p className="text-[13px] leading-relaxed" style={{ color: C.muted }}>{info.management}</p>
          </div>
        ))}
      </div>
    );
    if (activeTab === 2) return (
      <div className="space-y-4">
        {precautions.map(({ icon, title, items }) => (
          <div key={title} className="rounded-2xl p-6" style={{ background: C.white, boxShadow: "0 2px 12px rgba(30,26,23,0.07)" }}>
            <div className="flex items-center gap-2 mb-4">
              <span className="text-[18px]">{icon}</span>
              <h3 className="text-[15px] font-black" style={{ color: C.dark }}>{title}</h3>
            </div>
            <ul className="space-y-2.5">
              {items.map((item) => (
                <li key={item} className="flex items-start gap-2.5">
                  <div className="w-1.5 h-1.5 rounded-full mt-2 shrink-0" style={{ background: title === "절대 금지" ? "#D94F4F" : title === "주의 사항" ? C.coral : C.sage }} />
                  <p className="text-[14px] leading-relaxed" style={{ color: C.dark }}>{item}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    );
    // activeTab === 3 — lifestyle
    return (
      <div className="space-y-5">
        {lifestyle.map(({ category, icon, items }) => (
          <div key={category} className="rounded-2xl p-6" style={{ background: C.white, boxShadow: "0 2px 12px rgba(30,26,23,0.07)" }}>
            <div className="flex items-center gap-2.5 mb-4">
              <span className="text-[20px]">{icon}</span>
              <h3 className="text-[16px] font-black" style={{ color: C.dark }}>{category}</h3>
            </div>
            <div className="space-y-3">
              {items.map(({ label, desc }) => (
                <div key={label} className="flex gap-3 p-3 rounded-xl" style={{ background: C.ivory }}>
                  <span className="text-[12px] font-black px-2 py-0.5 rounded-full shrink-0 self-start mt-0.5" style={{ background: `${C.sage}20`, color: "#4A7A47" }}>{label}</span>
                  <p className="text-[13px] leading-relaxed" style={{ color: C.dark }}>{desc}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    );
  };

  return (
    <div style={{ background: C.ivory, minHeight: "100vh", fontFamily: "'Noto Sans KR', sans-serif" }}>
      <Navbar loggedIn onNavigate={onNavigate} />
      <main className="max-w-2xl mx-auto px-8 pt-28 pb-24">
        <button onClick={() => onNavigate("ocr-review")}
                className="flex items-center gap-1.5 text-[13px] font-bold mb-6 hover:opacity-60 transition-opacity"
                style={{ color: C.muted }}>← 처방전 확인으로</button>

        {/* Header */}
        <div className="rounded-3xl p-7 mb-6" style={{ background: `linear-gradient(135deg, ${C.terracotta} 0%, #A5522F 100%)`, boxShadow: "0 8px 32px rgba(193,101,61,0.30)" }}>
          <div className="flex items-start gap-4">
            <div className="w-14 h-14 rounded-2xl flex items-center justify-center shrink-0 text-[28px]" style={{ background: "rgba(255,255,255,0.18)" }}>📋</div>
            <div>
              <p className="text-[13px] mb-1" style={{ color: "rgba(255,255,255,0.65)" }}>AI 맞춤 복약 가이드</p>
              <h1 className="text-[22px] font-black mb-2" style={{ color: C.white }}>고혈압·당뇨·이상지질혈증<br />복약 가이드</h1>
              <div className="flex flex-wrap gap-1.5">
                {["암로디핀 5mg", "메트포르민 500mg", "아스피린 100mg", "아토르바스타틴 20mg"].map((d) => (
                  <span key={d} className="px-2.5 py-1 rounded-full text-[11px] font-bold" style={{ background: "rgba(255,255,255,0.18)", color: C.white }}>{d}</span>
                ))}
              </div>
            </div>
          </div>
        </div>

        {/* Disclaimer */}
        <div className="flex items-start gap-2 px-4 py-3 rounded-xl mb-5" style={{ background: "rgba(224,138,91,0.10)", border: "1px solid rgba(224,138,91,0.22)" }}>
          <span className="text-[13px] shrink-0">ℹ️</span>
          <p className="text-[12px] leading-relaxed" style={{ color: "#7A4B28" }}>AI가 생성한 참고용 가이드입니다. 정확한 복약 지도는 담당 의사·약사에게 확인하세요.</p>
        </div>

        {/* Tab bar */}
        <div className="flex gap-1 p-1 rounded-2xl mb-6" style={{ background: "rgba(30,26,23,0.07)" }}>
          {tabs.map((t, i) => (
            <button key={t} onClick={() => setActiveTab(i)}
                    className="flex-1 py-2.5 rounded-xl text-[13px] font-bold transition-all"
                    style={{ background: activeTab === i ? C.white : "transparent", color: activeTab === i ? C.dark : C.muted, boxShadow: activeTab === i ? "0 1px 4px rgba(30,26,23,0.10)" : "none" }}>
              {t}
            </button>
          ))}
        </div>

        {tabContent()}

        {/* CTA */}
        <div className="flex gap-3 mt-6">
          <button onClick={() => onNavigate("schedule")}
                  className="flex-1 py-4 rounded-full font-bold text-[15px] border-2 transition-all hover:bg-gray-50"
                  style={{ borderColor: C.terracotta, color: C.terracotta }}>
            복약 일정 설정하기
          </button>
          <button onClick={() => onNavigate("chatbot")}
                  className="flex-1 py-4 rounded-full font-bold text-[15px] text-white transition-all hover:opacity-88"
                  style={{ background: C.terracotta }}>
            챗봇에게 질문 💬
          </button>
        </div>
        <p className="text-center text-[12px] mt-6" style={{ color: C.muted }}>본 정보는 의료진의 진단·처방을 대체하지 않습니다</p>
      </main>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// PATIENT MANAGEMENT PAGE — 환자 관리
// ══════════════════════════════════════════════════════════════════════════════
interface PatientRecord {
  id: number; name: string; age: number; gender: "여성" | "남성";
  phone: string; diagnosis: string; status: "복약중" | "중단";
}
const PATIENTS: PatientRecord[] = [
  { id: 1, name: "김건강", age: 82, gender: "여성", phone: "010-1234-5678", diagnosis: "고혈압·당뇨", status: "복약중" },
  { id: 2, name: "이복자", age: 75, gender: "남성", phone: "010-2345-6789", diagnosis: "이상지질혈증", status: "복약중" },
  { id: 3, name: "박순자", age: 88, gender: "여성", phone: "010-3456-7890", diagnosis: "고혈압", status: "중단" },
  { id: 4, name: "최길동", age: 71, gender: "남성", phone: "010-4567-8901", diagnosis: "당뇨", status: "복약중" },
];

function PatientMgmtPage({ onNavigate }: { onNavigate: (s: Screen) => void }) {
  const [search, setSearch] = useState("");
  const [genderFilter, setGenderFilter] = useState<"전체" | "여성" | "남성">("전체");
  const [minAge, setMinAge] = useState("");
  const [maxAge, setMaxAge] = useState("");
  const [registerModal, setRegisterModal] = useState(false);
  const [detailId, setDetailId] = useState<number | null>(null);

  const filtered = PATIENTS.filter((p) => {
    if (search && !p.name.includes(search)) return false;
    if (genderFilter !== "전체" && p.gender !== genderFilter) return false;
    if (minAge && p.age < parseInt(minAge)) return false;
    if (maxAge && p.age > parseInt(maxAge)) return false;
    return true;
  });

  const detail = PATIENTS.find((p) => p.id === detailId);

  return (
    <div style={{ background: C.ivory, minHeight: "100vh", fontFamily: "'Noto Sans KR', sans-serif" }}>
      <Navbar loggedIn onNavigate={onNavigate} />
      <main className="max-w-4xl mx-auto px-8 pt-28 pb-24">
        <div className="flex items-center justify-between mb-8">
          <div>
            <button onClick={() => onNavigate("mypage")} className="text-[13px] font-bold mb-2 block hover:opacity-60 transition-opacity" style={{ color: C.muted }}>← 마이페이지</button>
            <h1 className="text-[28px] font-black" style={{ color: C.dark }}>환자 관리</h1>
            <p className="text-[14px] mt-1" style={{ color: C.muted }}>연결된 환자 {PATIENTS.length}명의 복약 현황을 관리하세요.</p>
          </div>
          <button onClick={() => setRegisterModal(true)}
                  className="flex items-center gap-2 px-6 py-3 rounded-full text-white font-bold text-[15px] hover:opacity-88 transition-all"
                  style={{ background: C.terracotta, boxShadow: "0 4px 16px rgba(193,101,61,0.28)" }}>
            <Plus className="w-4 h-4" />환자 등록
          </button>
        </div>

        {/* Search / filter bar */}
        <div className="flex flex-wrap gap-3 mb-6">
          <div className="relative flex-1 min-w-[200px]">
            <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4" style={{ color: C.muted }} />
            <input value={search} onChange={(e) => setSearch(e.target.value)} placeholder="이름 검색"
                   className="w-full pl-11 pr-4 py-3 rounded-xl border text-[14px] outline-none bg-white" style={{ borderColor: "rgba(30,26,23,0.15)" }} />
          </div>
          <select value={genderFilter} onChange={(e) => setGenderFilter(e.target.value as typeof genderFilter)}
                  className="px-4 py-3 rounded-xl border text-[14px] outline-none bg-white" style={{ borderColor: "rgba(30,26,23,0.15)", minWidth: 100 }}>
            {["전체", "여성", "남성"].map((g) => <option key={g}>{g}</option>)}
          </select>
          <input type="number" value={minAge} onChange={(e) => setMinAge(e.target.value)} placeholder="최소 나이"
                 className="w-24 px-4 py-3 rounded-xl border text-[14px] outline-none bg-white" style={{ borderColor: "rgba(30,26,23,0.15)" }} />
          <input type="number" value={maxAge} onChange={(e) => setMaxAge(e.target.value)} placeholder="최대 나이"
                 className="w-24 px-4 py-3 rounded-xl border text-[14px] outline-none bg-white" style={{ borderColor: "rgba(30,26,23,0.15)" }} />
          <button onClick={() => { setSearch(""); setGenderFilter("전체"); setMinAge(""); setMaxAge(""); }}
                  className="px-5 py-3 rounded-xl font-bold text-[14px] hover:opacity-80 transition-opacity"
                  style={{ background: `${C.sage}18`, color: "#4A7A47" }}>
            초기화
          </button>
        </div>

        {/* Patient table */}
        <div className="rounded-2xl overflow-hidden" style={{ background: C.white, boxShadow: "0 2px 20px rgba(30,26,23,0.07)" }}>
          <table className="w-full">
            <thead>
              <tr style={{ background: "#FAFAF7", borderBottom: `1px solid ${C.lightBorder}` }}>
                {["ID", "이름", "나이", "성별", "전화번호", "진단명", "상태", "관리"].map((h) => (
                  <th key={h} className="px-5 py-3.5 text-left text-[11px] font-black uppercase tracking-wider" style={{ color: C.muted }}>{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {filtered.length === 0 ? (
                <tr><td colSpan={8} className="text-center py-16 text-[15px]" style={{ color: C.muted }}>검색 결과가 없습니다.</td></tr>
              ) : (
                filtered.map((p, i) => (
                  <tr key={p.id} className="transition-colors hover:bg-gray-50"
                      style={{ borderBottom: i < filtered.length - 1 ? `1px solid ${C.lightBorder}` : undefined }}>
                    <td className="px-5 py-4 text-[13px] font-bold" style={{ color: C.muted }}>{p.id}</td>
                    <td className="px-5 py-4 font-bold text-[15px]" style={{ color: C.dark }}>{p.name}</td>
                    <td className="px-5 py-4 text-[14px]" style={{ color: C.dark }}>{p.age}세</td>
                    <td className="px-5 py-4 text-[14px]" style={{ color: C.dark }}>{p.gender}</td>
                    <td className="px-5 py-4 text-[13px]" style={{ color: C.muted }}>{p.phone}</td>
                    <td className="px-5 py-4 text-[13px]" style={{ color: C.dark }}>{p.diagnosis}</td>
                    <td className="px-5 py-4">
                      <span className="px-3 py-1 rounded-full text-[12px] font-bold"
                            style={{ background: p.status === "복약중" ? `${C.sage}20` : "rgba(30,26,23,0.07)", color: p.status === "복약중" ? C.sage : C.muted }}>
                        {p.status}
                      </span>
                    </td>
                    <td className="px-5 py-4">
                      <button onClick={() => setDetailId(p.id)}
                              className="px-4 py-2 rounded-full text-[13px] font-bold text-white transition-all hover:opacity-80"
                              style={{ background: C.terracotta }}>
                        상세보기
                      </button>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
          <div className="px-5 py-3 border-t flex items-center justify-between" style={{ borderColor: C.lightBorder }}>
            <p className="text-[12px]" style={{ color: C.muted }}>총 {filtered.length}명 / 전체 {PATIENTS.length}명</p>
          </div>
        </div>
      </main>

      {/* Detail modal */}
      {detail && (
        <div className="fixed inset-0 z-50 flex items-center justify-center px-4" style={{ background: "rgba(30,26,23,0.55)" }} onClick={() => setDetailId(null)}>
          <div className="rounded-3xl p-8 w-full max-w-md" style={{ background: C.white }} onClick={(e) => e.stopPropagation()}>
            <div className="flex items-center gap-4 mb-6">
              <div className="w-14 h-14 rounded-2xl flex items-center justify-center text-white text-[22px] font-black shrink-0" style={{ background: C.terracotta }}>
                {detail.name[0]}
              </div>
              <div>
                <h3 className="text-[20px] font-black" style={{ color: C.dark }}>{detail.name}</h3>
                <p className="text-[13px]" style={{ color: C.muted }}>{detail.age}세 · {detail.gender} · {detail.phone}</p>
              </div>
            </div>
            <div className="space-y-3 mb-6">
              {[
                { label: "진단명", value: detail.diagnosis },
                { label: "복약 상태", value: detail.status },
                { label: "담당 지원", value: "김보호 (보호자)" },
                { label: "최근 복약", value: "2025.07.07 08:00 완료" },
              ].map(({ label, value }) => (
                <div key={label} className="flex items-center justify-between py-2.5 border-b last:border-0" style={{ borderColor: C.lightBorder }}>
                  <span className="text-[13px]" style={{ color: C.muted }}>{label}</span>
                  <span className="text-[14px] font-semibold" style={{ color: C.dark }}>{value}</span>
                </div>
              ))}
            </div>
            <div className="flex gap-3">
              <button onClick={() => setDetailId(null)}
                      className="flex-1 py-3.5 rounded-full font-bold border-2 text-[15px]"
                      style={{ borderColor: "rgba(30,26,23,0.15)", color: C.dark }}>
                닫기
              </button>
              <button onClick={() => { setDetailId(null); onNavigate("monitoring"); }}
                      className="flex-[1.5] py-3.5 rounded-full text-white font-black text-[15px] hover:opacity-88 transition-all"
                      style={{ background: C.terracotta }}>
                모니터링 보기
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Register modal */}
      {registerModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center px-4" style={{ background: "rgba(30,26,23,0.55)" }} onClick={() => setRegisterModal(false)}>
          <div className="rounded-3xl p-8 w-full max-w-sm" style={{ background: C.white }} onClick={(e) => e.stopPropagation()}>
            <h3 className="text-[20px] font-black mb-5" style={{ color: C.dark }}>환자 등록</h3>
            <div className="space-y-4">
              {[["이름", "홍길동", "text"], ["나이", "75", "number"], ["전화번호", "010-0000-0000", "tel"]].map(([label, ph, type]) => (
                <div key={label}>
                  <label className="block text-[13px] font-bold mb-1.5" style={{ color: C.dark }}>{label}</label>
                  <input type={type} placeholder={ph} className="w-full px-4 py-3 rounded-xl border text-[14px] outline-none" style={{ borderColor: "rgba(30,26,23,0.15)", background: C.ivory }} />
                </div>
              ))}
              <div>
                <label className="block text-[13px] font-bold mb-1.5" style={{ color: C.dark }}>성별</label>
                <div className="flex gap-2">
                  {["여성", "남성"].map((g) => (
                    <button key={g} className="flex-1 py-3 rounded-xl font-bold text-[14px]" style={{ background: `${C.terracotta}10`, color: C.terracotta }}>{g}</button>
                  ))}
                </div>
              </div>
            </div>
            <div className="flex gap-3 mt-6">
              <button onClick={() => setRegisterModal(false)} className="flex-1 py-3.5 rounded-full font-bold border-2 text-[15px]" style={{ borderColor: "rgba(30,26,23,0.15)", color: C.dark }}>취소</button>
              <button onClick={() => setRegisterModal(false)} className="flex-[1.5] py-3.5 rounded-full text-white font-black text-[15px] hover:opacity-88" style={{ background: C.terracotta }}>등록</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// ROOT APP
// ══════════════════════════════════════════════════════════════════════════════
const ALL_SCREENS: { key: Screen; label: string }[] = [
  { key: "landing", label: "① 랜딩" },
  { key: "login", label: "② 로그인" },
  { key: "signup", label: "③ 회원가입" },
  { key: "dashboard", label: "④ 홈" },
  { key: "caregiver", label: "⑤ 보호자 연결" },
  { key: "invite", label: "⑥ 초대 수락" },
  { key: "assessment", label: "⑦ 자가진단" },
  { key: "ocr-upload", label: "⑧ 처방전 업로드" },
  { key: "ocr-review", label: "⑨ 처방전 확인" },
  { key: "schedule", label: "⑩ 복약 일정" },
  { key: "notification", label: "⑪ 알림 설정" },
  { key: "monitoring", label: "⑫ 모니터링" },
  { key: "records", label: "⑬ 이용 기록" },
  { key: "mypage", label: "⑭ 마이페이지" },
  { key: "chatbot", label: "⑮ AI 챗봇" },
  { key: "drug-detail", label: "⑯ 약품 상세" },
  { key: "prescription-detail", label: "⑰ 처방 상세" },
  { key: "med-guide", label: "⑱ 복약 가이드" },
  { key: "patient-mgmt", label: "⑲ 환자 관리" },
  { key: "care-education", label: "⑳ 교육 관리" },
  { key: "locked", label: "⑳ 계정 잠금" },
  { key: "ocr-error", label: "㉑ OCR 오류" },
];

export default function App() {
  const [screen, setScreen] = useState<Screen>("landing");
  const [selectedDate, setSelectedDate] = useState<string | null>(null);
  const [selectedDrug, setSelectedDrug] = useState<string | null>(null);
  const [selectedPrescriptionId, setSelectedPrescriptionId] = useState<number | null>(null);
  const [fontSize, setFontSize] = useState<FontSize>("medium");

  function navTo(s: Screen) { setScreen(s); }

  const fontSizePx: Record<FontSize, number> = { small: 14, medium: 16, large: 20 };

  return (
    <div style={{ fontFamily: "'Noto Sans KR', sans-serif", fontSize: fontSizePx[fontSize] }}>
      {/* Demo switcher */}
      <div className="fixed top-0 left-0 right-0 z-50 flex items-center gap-1.5 px-4 overflow-x-auto"
           style={{ height: 32, background: C.dark, scrollbarWidth: "none" }}>
        <span className="text-[10px] font-medium mr-1 shrink-0" style={{ color: "rgba(255,255,255,0.35)" }}>화면</span>
        {ALL_SCREENS.map(({ key, label }) => (
          <button key={key} onClick={() => { if (key === "drug-detail" && !selectedDrug) setSelectedDrug("암로디핀 5mg"); if (key === "prescription-detail" && !selectedPrescriptionId) setSelectedPrescriptionId(1); setScreen(key); }}
                  className="px-2.5 py-0.5 rounded-full text-[10px] font-bold whitespace-nowrap transition-all shrink-0"
                  style={{ background: screen === key ? C.terracotta : "rgba(255,255,255,0.08)", color: screen === key ? C.white : "rgba(255,255,255,0.5)" }}>
            {label}
          </button>
        ))}
      </div>

      {screen === "landing" && <LandingPage onNavigate={setScreen} />}
      {screen === "login" && <LoginPage onNavigate={setScreen} />}
      {screen === "signup" && <SignupPage onNavigate={setScreen} />}
      {screen === "dashboard" && <DashboardPage onNavigate={setScreen} />}
      {screen === "caregiver" && <CaregiverPage />}
      {screen === "invite" && <InvitePage />}
      {screen === "assessment" && <AssessmentPage />}
      {screen === "ocr-upload" && <OcrUploadPage onNavigate={setScreen} />}
      {screen === "ocr-review" && <OcrReviewPage onNavigate={setScreen} />}
      {screen === "schedule" && <SchedulePage />}
      {screen === "notification" && <NotificationPage />}
      {screen === "monitoring" && <MonitoringPage onNavigate={navTo} onSelectDate={(d) => { setSelectedDate(d); navTo("records"); }} onSelectDrug={(drug) => { setSelectedDrug(drug); navTo("drug-detail"); }} />}
      {screen === "records" && <RecordsPage selectedDate={selectedDate} onNavigate={navTo} onSelectPrescription={(id) => { setSelectedPrescriptionId(id); }} />}
      {screen === "prescription-detail" && <PrescriptionDetailPage prescriptionId={selectedPrescriptionId} onNavigate={navTo} />}
      {screen === "med-guide" && <MedGuidePage onNavigate={navTo} />}
      {screen === "drug-detail" && <DrugDetailPage drug={selectedDrug} onNavigate={navTo} />}
      {screen === "mypage" && <MyPage onNavigate={setScreen} fontSize={fontSize} setFontSize={setFontSize} />}
      {screen === "patient-mgmt" && <PatientMgmtPage onNavigate={navTo} />}
      {screen === "care-education" && <CareEducationPage />}
      {screen === "locked" && <LockedPage />}
      {screen === "ocr-error" && <OcrErrorPage onNavigate={setScreen} />}
      {screen === "chatbot" && <ChatbotPage onNavigate={setScreen} />}
    </div>
  );
}
